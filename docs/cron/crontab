 ── NTP Sync on Boot & NTP Check every 10 minutes ─────────────────
# Schedule : once at system boot (delay 30s for network readiness) & every 10 minutes
# Script   : /usr/local/sbin/ntp-sync.sh
# Log      : /var/log/sys-maint.log
# Rotated  : /etc/logrotate.d/ntp-sync
@reboot      root sleep 30 && /usr/local/sbin/ntp-sync.sh >> /var/log/sys-maint.log 2>&1
*/10 * * * * root sleep 30 && /usr/local/sbin/ntp-sync.sh >> /var/log/sys-maint.log 2>&1

# ── System Maintenance ────────────────────────────────────────────
# Run system maintenance (update + cleanup) every day at 08:30
# Logs output to /var/log/sys-maint.log
# Schedule : once at system boot (delay 30s for network readiness) & every day at 08:45
# Script   : /usr/local/bin/sys-maint.sh
# Log      : /var/log/sys-maint.log
# Rotated  : /etc/logrotate.d/sys-maint
45 8 * * * root /usr/local/sbin/sys-maint.sh >> /var/log/sys-maint.log 2>&1
@reboot    root /usr/local/sbin/sys-maint.sh >> /var/log/sys-maint.log 2>&1
#0 9 * * * root /usr/local/sbin/sys-maint.sh >> /var/log/sys-maint.log 2>&1

