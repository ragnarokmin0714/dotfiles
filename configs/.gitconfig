# =============================================================================
# configs/.gitconfig — Git Global Configuration Template
# =============================================================================
# Deployed to ~/.gitconfig by running:
#   cp configs/.gitconfig ~/.gitconfig
# or manually via: git config --global ...
# =============================================================================

[user]
	name  = Roger
	email = your-email@example.com     # Replace with your actual email

[core]
	editor     = vim                   # Default editor for commit messages
	autocrlf   = input                 # Convert CRLF to LF on commit (Linux)
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[color]
	ui = auto                          # Enable colored output in terminal

[pull]
	rebase = false                     # Merge instead of rebase on pull

[push]
	default = current                  # Push current branch to same-name remote branch

[alias]
	# Short status
	st = status -sb

	# Compact one-line log with graph
	lg = log --oneline --graph --decorate --all

	# Undo last commit but keep changes staged
	undo = reset --soft HEAD~1

	# List all aliases
	aliases = config --get-regexp alias

	# Clean up merged local branches
	cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"

[init]
	defaultBranch = main               # Use 'main' instead of 'master' for new repos
