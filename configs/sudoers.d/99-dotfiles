# =============================================================================
# configs/sudoers.d/99-dotfiles — Sudo Rules for Deploy User
# =============================================================================
# This file is deployed to /etc/sudoers.d/ by system/sudo.sh.
# The placeholder __USER__ is replaced with the actual username.
#
# SECURITY POLICY:
#   - Grants NOPASSWD sudo only for specific, well-known commands.
#   - Never use NOPASSWD: ALL in production.
#   - Add or remove commands from the list as needed.
#
# VALIDATE BEFORE USE:
#   visudo -c -f /etc/sudoers.d/99-dotfiles
# =============================================================================

# Allow the deploy user to manage services without a password
__USER__ ALL=(ALL) NOPASSWD: /usr/bin/systemctl start *
__USER__ ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop *
__USER__ ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart *
__USER__ ALL=(ALL) NOPASSWD: /usr/bin/systemctl status *
__USER__ ALL=(ALL) NOPASSWD: /usr/bin/systemctl enable *

# Allow the deploy user to manage Docker
__USER__ ALL=(ALL) NOPASSWD: /usr/bin/docker

# Allow the deploy user to manage network configuration
__USER__ ALL=(ALL) NOPASSWD: /usr/sbin/netplan apply

# Allow the deploy user to run apt-get (package installation)
__USER__ ALL=(ALL) NOPASSWD: /usr/bin/apt-get

# Allow the deploy user to manage the firewall
__USER__ ALL=(ALL) NOPASSWD: /usr/sbin/ufw
