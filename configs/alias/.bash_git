#!/usr/bin/env bash
# @file .bash_git
# @brief Git helpers: amend, merge, switch, push, clean up, stash, restore and find.
# @description
#   Remote and integration branch come from GIT_REMOTE / GIT_MAIN_BRANCH (.bash_env),
#   so a repo on `master` or a remote named `upstream` only overrides those.
#   Every command takes what it needs as arguments; the branch / stash / file menus
#   open only when an argument is missing and there is a terminal (.bash_ui).

# @name _git_need_repo
# @description Internal: succeed inside a work tree, else log and fail.
_git_need_repo() {
    git rev-parse --is-inside-work-tree &>/dev/null && return 0
    log_err "Not inside a git repository"
    return 1
}

# @name _git_current_branch
# @description Internal: echo the checked-out branch; fail (logged) on detached HEAD.
_git_current_branch() {
    git symbolic-ref --short HEAD 2>/dev/null && return 0
    log_err "Cannot determine the current branch (detached HEAD?)"
    return 1
}

# Show the current branch with tracking info and last commit
alias git-branch-current='git branch -vv --color | grep "^\*"'
alias gbc='git-branch-current'

# Force push safely after an amend (refuses if the remote moved meanwhile)
alias safe-push='git push --force-with-lease'
alias amend-safe-push='git commit --amend --no-edit && git push --force-with-lease'

# Fetch and prune: one remote / every remote
alias gfp='git fetch --prune'
alias gfap='git fetch --all --prune'

# Pull the integration branch into the current one
alias gpm='git pull "$GIT_REMOTE" "$GIT_MAIN_BRANCH"'
alias git-pull-main='gpm'

# Undo the last commit: keep its changes staged / discard them (irreversible)
alias git-undo='git reset --soft HEAD~1'
alias git-drop='git reset --hard HEAD~1'

# @name git_amend
# @description Amend the last commit, keeping its message -- or replacing it with -m.
# @param -m string  Optional new commit message
# @example amend
# @example amend -m "fix: correct typo in button label"
git_amend() {
    local msg="" usage="usage: git_amend [-m message]"
    while (( $# )); do
        case "$1" in
            -m | --message) msg="${2:-}"; [[ -n "$msg" ]] || { log_err "$usage"; return 1; }; shift ;;
            -h | --help)    echo "$usage"; return 0 ;;
            *) log_err "Unknown argument: $1 -- ${usage}"; return 1 ;;
        esac
        shift
    done
    if [[ -n "$msg" ]]; then
        git commit --amend -m "$msg" || { log_err "Amend failed"; return 1; }
        log_ok "Amended with new message: ${msg}"
    else
        git commit --amend --no-edit || { log_err "Amend failed"; return 1; }
        log_ok "Amended, message unchanged"
    fi
}
alias amend='git_amend'
alias git-amend='git_amend'

# @name git_fetch_merge
# @description Fetch a branch from GIT_REMOTE and merge it into the current branch.
#              With no branch, pick one of the remote's branches; a branch picked from
#              the menu is confirmed before merging, a named one is merged at once.
# @param $1          string  Remote branch to merge (default: menu)
# @param -y | --yes  flag    Skip the confirmation after a menu pick
# @example gfm               # menu
# @example gfm featureA
git_fetch_merge() {
    local branch="" yes=0 usage="usage: git_fetch_merge [-y] [branch]"
    while (( $# )); do
        case "$1" in
            -y | --yes)  yes=1 ;;
            -h | --help) echo "$usage"; return 0 ;;
            -*) log_err "Unknown option: $1 -- ${usage}"; return 1 ;;
            *)  branch="$1" ;;
        esac
        shift
    done
    _git_need_repo || return 1
    local current
    current=$(_git_current_branch) || return 1

    if [[ -z "$branch" ]]; then
        ui_tty || { log_err "$usage"; return 1; }
        log_info "Fetching ${GIT_REMOTE}..."
        git fetch "$GIT_REMOTE" --prune 2>/dev/null
        local -a available=()
        local b pick
        while IFS= read -r b; do
            [[ -n "$b" && "$b" != "$current" ]] && available+=("$b")
        done < <(git branch -r --format='%(refname:short)' | grep "^${GIT_REMOTE}/" | grep -v '/HEAD$' | sed "s|^${GIT_REMOTE}/||")
        (( ${#available[@]} )) || { log_err "No other ${GIT_REMOTE} branches to merge"; return 1; }
        radioselect pick "Merge which branch into ${current}?" -1 "${available[@]}" || { log_info "Cancelled"; return 0; }
        branch="${available[$pick]}"
        (( yes )) || confirm "Merge ${GIT_REMOTE}/${branch} into ${current}?" || { log_info "Cancelled"; return 0; }
    fi

    git fetch "$GIT_REMOTE" "$branch" || { log_err "Failed to fetch ${GIT_REMOTE}/${branch}"; return 1; }
    log_warn "Merging ${GIT_REMOTE}/${branch} into ${current}..."
    git merge "${GIT_REMOTE}/${branch}" || { log_err "Merge stopped -- resolve the conflicts, then commit"; return 1; }
    log_ok "Merged ${GIT_REMOTE}/${branch} into ${current}"
}
alias gfm='git_fetch_merge'
alias git-fetch-merge='git_fetch_merge'

# @name git_clean_merged
# @description Delete local branches already merged into a base branch. Lists them
#              and confirms first. Uses `git branch -d`, never -D, so git itself
#              refuses any branch with unmerged commits; the base and current branches
#              are never listed. Deleted branches stay in the reflog for ~90 days:
#              `git branch <name> <sha>`. Run `gfp` first so the base is up to date.
#              NOTE: needs real merge commits -- under squash or rebase merges
#              `git branch --merged` cannot see the merge, so nothing lists.
# @param $1              string  Base branch (default: GIT_MAIN_BRANCH)
# @param -n | --dry-run  flag    List only, delete nothing
# @param -y | --yes      flag    Delete without asking
# @example gcmb
# @example gcmb -n develop
git_clean_merged() {
    local dry=0 yes=0 base="" usage="usage: git_clean_merged [-n] [-y] [base-branch]"
    while (( $# )); do
        case "$1" in
            -n | --dry-run) dry=1 ;;
            -y | --yes)     yes=1 ;;
            -h | --help)    echo "$usage"; return 0 ;;
            -*) log_err "Unknown option: $1 -- ${usage}"; return 1 ;;
            *)  base="$1" ;;
        esac
        shift
    done
    _git_need_repo || return 1
    base="${base:-$GIT_MAIN_BRANCH}"
    git show-ref --verify --quiet "refs/heads/${base}" || { log_err "Base branch not found: ${base}"; return 1; }

    local current b
    current=$(git symbolic-ref --short HEAD 2>/dev/null)
    local -a candidates=()
    while IFS= read -r b; do
        [[ -z "$b" || "$b" == "$base" || "$b" == "$current" ]] && continue
        candidates+=("$b")
    done < <(git branch --merged "$base" --format='%(refname:short)')
    (( ${#candidates[@]} )) || { log_info "No merged branches to clean (base: ${base})"; return 0; }

    log_head "Merged into ${base} (${#candidates[@]})"
    printf '  %s\n' "${candidates[@]}"
    log_info "Kept: ${base} (base)${current:+, ${current} (current)}, and every unmerged branch"
    (( dry )) && { log_info "Dry run -- nothing deleted"; return 0; }
    (( yes )) || confirm "Delete these ${#candidates[@]} branches?" || { log_info "Cancelled"; return 0; }

    local deleted=0 skipped=0
    for b in "${candidates[@]}"; do
        if git branch -d "$b" &>/dev/null; then
            log_ok "Deleted: ${b}"; (( deleted++ ))
        else
            # -d also refuses a branch checked out in another worktree
            log_warn "Skipped: ${b} (refused by git branch -d)"; (( skipped++ ))
        fi
    done
    log_info "Deleted ${deleted}, skipped ${skipped}. Recover with: git branch <name> <sha> (see git reflog)"
}
alias git-clean-merged='git_clean_merged'
alias gcmb='git_clean_merged'

# @name git_switch_and_pull
# @description Switch to a local branch, then pull the integration branch into it
#              (GIT_REMOTE/GIT_MAIN_BRANCH, or -b). With no branch, pick one.
# @param $1               string  Branch to switch to (default: menu)
# @param -b | --base      string  Branch to pull after switching (default: GIT_MAIN_BRANCH)
# @param    --no-pull     flag    Only switch
# @example gswp               # menu
# @example gswp feature-x
# @example gswp feature-x -b develop
git_switch_and_pull() {
    local target="" base="$GIT_MAIN_BRANCH" pull=1
    local usage="usage: git_switch_and_pull [-b base] [--no-pull] [branch]"
    while (( $# )); do
        case "$1" in
            -b | --base) base="${2:-}"; [[ -n "$base" ]] || { log_err "$usage"; return 1; }; shift ;;
            --no-pull)   pull=0 ;;
            -h | --help) echo "$usage"; return 0 ;;
            -*) log_err "Unknown option: $1 -- ${usage}"; return 1 ;;
            *)  target="$1" ;;
        esac
        shift
    done
    _git_need_repo || return 1
    local current
    current=$(_git_current_branch) || return 1

    if [[ -z "$target" ]]; then
        ui_tty || { log_err "$usage"; return 1; }
        local -a branches
        local pick
        mapfile -t branches < <(git branch --format='%(refname:short)' | grep -vx -- "$current")
        (( ${#branches[@]} )) || { log_warn "No other local branches (current: ${current})"; return 1; }
        radioselect pick "Switch from ${current} to:" -1 "${branches[@]}" || { log_info "Cancelled"; return 0; }
        target="${branches[$pick]}"
    fi

    git switch "$target" || { log_err "Failed to switch to ${target}"; return 1; }
    (( pull )) || { log_ok "On ${target}"; return 0; }
    log_info "Pulling ${GIT_REMOTE}/${base} into ${target}..."
    git pull "$GIT_REMOTE" "$base" || { log_err "git pull failed"; return 1; }
    log_ok "On ${target}, up to date with ${GIT_REMOTE}/${base}"
}
alias git-switch-and-pull='git_switch_and_pull'
alias gswp='git_switch_and_pull'

# @name git_push_current_branch
# @description Push the current branch with upstream tracking, after a confirmation
#              (pushing is the one step here others see at once).
# @param -r | --remote  string  Remote (default: GIT_REMOTE)
# @param -y | --yes     flag    Push without asking
# @example gpcb
# @example gpcb -y -r upstream
git_push_current_branch() {
    local remote="$GIT_REMOTE" yes=0 usage="usage: git_push_current_branch [-y] [-r remote]"
    while (( $# )); do
        case "$1" in
            -r | --remote) remote="${2:-}"; [[ -n "$remote" ]] || { log_err "$usage"; return 1; }; shift ;;
            -y | --yes)    yes=1 ;;
            -h | --help)   echo "$usage"; return 0 ;;
            *) log_err "Unknown argument: $1 -- ${usage}"; return 1 ;;
        esac
        shift
    done
    _git_need_repo || return 1
    local current
    current=$(_git_current_branch) || return 1
    log_info "Command: git push -u ${remote} ${current}"
    (( yes )) || confirm "Push ${current} to ${remote}?" || { log_info "Push cancelled"; return 0; }
    git push -u "$remote" "$current" || { log_err "Push failed"; return 1; }
    log_ok "Pushed ${current} to ${remote}"
}
alias git-push-current-branch='git_push_current_branch'
alias gpcb='git_push_current_branch'

# @name git_checkout_remote
# @description Create a local tracking branch for a GIT_REMOTE branch that has no
#              local counterpart yet, and switch to it. With no branch, pick one.
# @param $1 string  Remote branch name, without the remote prefix (default: menu)
# @example gcr                # menu of remote-only branches
# @example gcr feature-x
git_checkout_remote() {
    local branch="" usage="usage: git_checkout_remote [branch]"
    case "${1:-}" in
        -h | --help) echo "$usage"; return 0 ;;
        -*) log_err "Unknown option: $1 -- ${usage}"; return 1 ;;
        *)  branch="${1:-}" ;;
    esac
    _git_need_repo || return 1
    log_info "Fetching ${GIT_REMOTE}..."
    git fetch "$GIT_REMOTE" --prune 2>/dev/null

    if [[ -z "$branch" ]]; then
        ui_tty || { log_err "$usage"; return 1; }
        local -a available=()
        local b pick
        while IFS= read -r b; do
            git show-ref --verify --quiet "refs/heads/${b}" || available+=("$b")
        done < <(git branch -r --format='%(refname:short)' | grep "^${GIT_REMOTE}/" | grep -v '/HEAD$' | sed "s|^${GIT_REMOTE}/||")
        (( ${#available[@]} )) || { log_err "No remote-only branches on ${GIT_REMOTE}"; return 1; }
        radioselect pick "Check out which ${GIT_REMOTE} branch?" -1 "${available[@]}" || { log_info "Cancelled"; return 0; }
        branch="${available[$pick]}"
    fi

    git show-ref --verify --quiet "refs/heads/${branch}" && { log_err "Local branch ${branch} exists -- use: git switch ${branch}"; return 1; }
    git switch -c "$branch" "${GIT_REMOTE}/${branch}" || { log_err "No such branch: ${GIT_REMOTE}/${branch}"; return 1; }
    log_ok "On ${branch}, tracking ${GIT_REMOTE}/${branch}"
}
alias git-checkout-remote='git_checkout_remote'
alias gcr='git_checkout_remote'

# @name git_drop_stashes
# @description Drop stashes. Name them by index -- single (3), range (16-19), comma
#              list (1,3,5) or `all` -- or pick them from a menu. Confirms first, then
#              drops from the highest index down so the remaining numbers hold still.
# @param $@          string  Indices / ranges / lists, or `all` (default: menu)
# @param -y | --yes  flag    Drop without asking
# @example gds                # menu
# @example gds 0 2 5-7
# @example gds all -y
git_drop_stashes() {
    local yes=0 all=0 usage="usage: git_drop_stashes [-y] [all | index | from-to | a,b,c ...]"
    local -a indices=()
    local arg i
    while (( $# )); do
        arg="$1"
        case "$arg" in
            -y | --yes)  yes=1 ;;
            -h | --help) echo "$usage"; return 0 ;;
            all)         all=1 ;;
            *-*[!0-9-]* | -*) log_err "Not an index: ${arg} -- ${usage}"; return 1 ;;
            [0-9]*-[0-9]*)
                for (( i = ${arg%-*}; i <= ${arg#*-}; i++ )); do indices+=("$i"); done ;;
            *[!0-9,]*)   log_err "Not an index: ${arg} -- ${usage}"; return 1 ;;
            *)           IFS=',' read -ra arg <<< "$arg"; indices+=("${arg[@]}") ;;
        esac
        shift
    done
    _git_need_repo || return 1

    local -a stashes
    mapfile -t stashes < <(git stash list)
    (( ${#stashes[@]} )) || { log_info "No stashes"; return 0; }

    if (( all )); then
        (( yes )) || confirm "Drop ALL ${#stashes[@]} stashes? This cannot be undone" || { log_info "Cancelled"; return 0; }
        git stash clear && log_ok "All stashes dropped"
        return
    fi

    if (( ${#indices[@]} == 0 )); then
        ui_tty || { log_err "$usage"; return 1; }
        local picks
        multiselect picks "Drop which stashes?" "${stashes[@]}" || { log_info "Cancelled"; return 0; }
        read -ra indices <<< "$picks"
        (( ${#indices[@]} )) || { log_info "Nothing selected"; return 0; }
    fi

    local -a sorted
    mapfile -t sorted < <(printf '%s\n' "${indices[@]}" | sort -rnu)
    log_info "Will drop: $(printf 'stash@{%s} ' "${sorted[@]}")"
    (( yes )) || confirm "Drop ${#sorted[@]} stash(es)?" || { log_info "Cancelled"; return 0; }
    for i in "${sorted[@]}"; do
        if (( i >= ${#stashes[@]} )); then
            log_warn "stash@{${i}} does not exist, skipped"
        elif git stash drop "stash@{${i}}" >/dev/null; then
            log_ok "Dropped stash@{${i}}"
        else
            log_err "Failed to drop stash@{${i}}"
        fi
    done
    log_info "Remaining stashes: $(git stash list | wc -l)"
}
alias git-drop-stashes='git_drop_stashes'
alias gds='git_drop_stashes'

# @name git_restore_deleted
# @description Find every file deleted under a path and interactively restore the
#              chosen ones. Files are restored to the WORKING TREE only (not staged,
#              not committed) so they can be reviewed before `git add`.
#              Each file is restored from the commit just BEFORE its deletion
#              (<sha>^), which is the last revision where it still existed.
#              A path deleted more than once resolves to its most recent deletion.
#              Existing files are never overwritten -- they are listed and skipped.
# @param $1 string Path to search (file or directory; default: repo root)
# @depends multiselect (.bash_ui)
# @example git_restore_deleted src/components/common
# @example git_restore_deleted            # whole repo
# @example grd src/helpers
git_restore_deleted() {
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        log_err "Not inside a git repository"
        return 1
    fi

    local path="${1:-.}"

    # `git log --name-only` prints paths relative to the REPO ROOT, but both the
    # existence test and `git restore` below resolve relative to the CWD. Run from
    # any subdirectory those disagree and every restore fails with an unmatched
    # pathspec, so anchor them to the top level.
    local root
    root=$(git rev-parse --show-toplevel)

    # One "<sha>\t<file>" line per deletion, newest first. --format seeds each
    # commit's sha, then --name-only lists that commit's deleted paths under it.
    local -a shas=() files=()
    local sha="" line
    while IFS= read -r line; do
        if [[ "$line" == sha:* ]]; then
            sha="${line#sha:}"
        elif [[ -n "$line" && -n "$sha" ]]; then
            # Keep only the newest deletion per path (git log is newest-first).
            local seen=0 f
            for f in "${files[@]}"; do
                [[ "$f" == "$line" ]] && { seen=1; break; }
            done
            (( seen )) || { shas+=("$sha"); files+=("$line"); }
        fi
    # core.quotePath defaults to true, which prints a non-ASCII path as an escaped,
    # quoted string ("docs/\344\270\255..."). Fed back to `git restore` that never
    # matches, so every CJK/accented filename failed to restore. Force it off.
    done < <(git -c core.quotePath=false log --diff-filter=D --name-only \
                 --format='sha:%H' -- "$path")

    if [[ ${#files[@]} -eq 0 ]]; then
        log_info "No deleted files found under: ${path}"

        # "Nothing was deleted" is also what you get for a path that simply never
        # existed on this branch -- it lives on another one. Same message, opposite
        # cause, and the message alone dead-ends. Name the branch that has it.
        if [[ -n "$1" && ! -e "${root}/$(git rev-parse --show-prefix)${path}" ]]; then
            local rel ref
            rel="$(git rev-parse --show-prefix)${path}"
            for ref in $(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes); do
                if git cat-file -e "${ref}:${rel}" 2>/dev/null; then
                    log_info "It was never deleted -- it lives on ${ref}:"
                    log_info "  git restore --source=${ref} -- ${rel}"
                    return 0
                fi
            done
            log_info "Not on any branch either. Search all history with: gfl ${path##*/}"
        fi
        return 0
    fi

    # multiselect renders every option on one cleared screen (no paging), so a
    # large result set would scroll the cursor out of view. Make the user narrow
    # the path instead of handing them an unusable menu.
    if [[ ${#files[@]} -gt 40 ]]; then
        log_warn "${#files[@]} deleted files under '${path}' -- the menu does not scroll."
        confirm "Show them all anyway? Narrowing the path is usually better." || { log_info "Cancelled"; return 0; }
    fi

    # Build one label per deletion; multiselect returns the chosen indices.
    # Without a terminal, list them: restoring is a choice someone has to make.
    if ! ui_tty; then
        printf '%s\n' "${files[@]}"
        log_err "Pick the files to restore from a terminal, or: git restore --source=<sha>^ -- <file>"
        return 1
    fi
    local -a labels=()
    local i meta
    for i in "${!files[@]}"; do
        meta=$(git log -1 --format='%h %ad %an' --date=short "${shas[$i]}")
        labels+=("${files[$i]}  (deleted in ${meta})")
    done

    local picks
    multiselect picks "Deleted under ${path} -- select files to restore:" "${labels[@]}" || {
        log_info "Cancelled"
        return 0
    }
    if [[ -z "$picks" ]]; then
        log_info "Nothing selected"
        return 0
    fi

    local restored=0 skipped=0
    for i in $picks; do
        local file="${files[$i]}" from="${shas[$i]}^"
        # -L so a broken symlink counts as present: -e alone is false for one, and
        # restoring would silently replace the user's link with file content.
        if [[ -e "${root}/${file}" || -L "${root}/${file}" ]]; then
            log_warn "Exists already, skipped: ${file}"
            (( skipped++ ))
            continue
        fi
        if git -C "$root" restore --source="$from" -- "$file" 2>/dev/null; then
            log_ok "Restored: ${file}  (from ${from})"
            (( restored++ ))
        else
            log_err "Failed to restore: ${file}  (from ${from})"
        fi
    done

    echo ""
    log_info "Restored ${restored}, skipped ${skipped}. Files are unstaged -- review, then 'git add'."
}
alias git-restore-deleted='git_restore_deleted'
alias grd='git_restore_deleted'

# @name git_find_lost
# @description Locate a file or directory missing from the working tree by searching
#              all history for the commit that added, deleted, or renamed it.
#              Read-only -- restores nothing (use `grd` for that).
#              The name is matched as a case-insensitive SUBSTRING of the full path,
#              so `gfl dropdown` finds src/components/common/dropdown.js and
#              `gfl scripts` finds everything under any scripts/ directory -- a
#              pathspec '*' crosses '/', so one pattern covers files and dirs both.
#              Each flag below fixes a failure mode where the search returns nothing
#              while the file DOES exist. A false "never committed" is worse than no
#              answer, so none of them are optional:
#                --reflog        finds commits no ref points at any more, dropped by
#                                `reset --hard`, `commit --amend`, or a deleted branch.
#                --full-history  any pathspec turns on history simplification, which
#                                prunes side branches the merge did not keep. Without
#                                it, a file added and removed inside a feature branch
#                                that was merged and deleted reports NOTHING.
#                :(icase)        pathspecs are case-sensitive by default.
#              NOTE: --diff-filter=ADR reports whole-file events only. A file that
#              still exists but had its CONTENT removed by some commit shows nothing
#              here -- use `git log -S'<snippet>' --all` for that.
# @param $1 string Any part of the file or directory name (case-insensitive)
# @example git_find_lost reset_db.mjs
# @example git_find_lost scripts
# @example gfl dropdown
git_find_lost() {
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        log_err "Not inside a git repository"
        return 1
    fi

    local name="$1"
    if [[ -z "$name" ]]; then
        log_err "Usage: git_find_lost <file-or-directory-name>"
        return 1
    fi

    # Tab-completion hands you './scripts'. The name is matched literally inside
    # '*...*', and no path in git's output carries a './' prefix, so leaving it on
    # matches nothing and reports a false "never committed".
    name="${name#./}"

    # core.quotePath=false: otherwise a non-ASCII path prints escaped and quoted,
    # which no existence test or restore command can match.
    local out
    out=$(git -c core.quotePath=false log --all --reflog --full-history --oneline \
              --name-status --diff-filter=ADR -- ":(icase)*${name}*")

    if [[ -z "$out" ]]; then
        log_warn "No add/delete/rename matching '${name}' in any ref or reflog"
        log_info "It may still be in a stash (git stash list), or was never committed."
        return 1
    fi

    log_head "History matching '${name}' (A=added D=deleted R=renamed)"
    echo "$out"
    echo ""

    # A path missing here but still alive on another branch was never deleted, so
    # `grd` (--diff-filter=D) will not offer it and dead-ends on "No deleted files".
    # Name the branch that still has it and print the exact restore command.
    # git prints these paths relative to the REPO ROOT, so the existence test must
    # be anchored there too -- CWD-relative, every path looks missing from a
    # subdirectory and the hint offers to overwrite files that are not even gone.
    local root path ref
    root=$(git rev-parse --show-toplevel)

    # -L keeps a broken symlink from counting as absent: the link itself is there,
    # and offering to restore over it would be wrong.
    local -a missing=()
    while IFS= read -r path; do
        [[ -z "$path" ]] && continue
        [[ -e "${root}/${path}" || -L "${root}/${path}" ]] && continue
        missing+=("$path")
    done < <(echo "$out" | awk -F'\t' '/^[ADR]/ {print $NF}' | sort -u)

    # Locating one path costs a `git cat-file` per ref, so a broad search forks
    # thousands of times and buries the output: 518 absent paths across 26 refs
    # measured 28s and printed 518 hints. Past a handful, say so and stop.
    if (( ${#missing[@]} > 10 )); then
        log_info "${#missing[@]} matched paths are absent from the working tree -- narrow the search for restore hints."
        return 0
    fi

    local found=0
    for path in "${missing[@]}"; do
        for ref in $(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes); do
            if git cat-file -e "${ref}:${path}" 2>/dev/null; then
                log_info "On ${ref}: git restore --source=${ref} -- ${path}"
                found=1
                break
            fi
        done
    done

    (( found )) || log_info "Read a version: git show <sha>:<path>   |  restore deleted files: grd <path>"
}
alias git-find-lost='git_find_lost'
alias gfl='git_find_lost'
