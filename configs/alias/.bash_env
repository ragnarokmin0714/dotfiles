#!/usr/bin/env bash
# @file .bash_env
# @brief Foundation of the runtime library: platform globals, defaults, style, log helpers.
# @description
#   Sourced first, before every other module -- interactively (via the system bashrc
#   hook), by /usr/local/sbin scripts under cron, and by the deploy framework
#   (lib/core.sh), which sources the repo copy. Holds what the other modules look up
#   rather than call as a feature:
#     - Platform : OS_* / PKG_MGR / SUDO / SYS_BASHRC, detected once from /etc/os-release
#     - Paths    : where each part of the dotfiles lands on the system
#     - Defaults : tunables (NOW_FMT, GIT_*, PKG_*, SYS_TOOLKIT*), and PATH additions
#     - Style    : the STYLE map of ANSI codes
#     - Log      : log_ok / log_err / log_warn / log_info / log_step / log_head / log_banner
#   Every global is `${VAR:-default}`, so .bash_local (sourced before this file) or the
#   environment can override any of them. Feature code does not belong here.
#   Never exits and never calls `set`: it is sourced into interactive shells.

# ##############################################################################
# @section Platform
# @description
#   Detected once from /etc/os-release -- the distro's own statement of what it is,
#   unlike probing for apt/dnf binaries (Ubuntu can have dnf installed). Supported:
#   Ubuntu 20.04+ / Debian 11+ (family debian) and RHEL / Rocky / Alma 9+ (family rhel).
#   Preset OS_FAMILY (with OS_ID / OS_VERSION) to simulate another distro, e.g. for a
#   dry run of the rhel code paths on an Ubuntu box.
# ##############################################################################

if [[ -z "${OS_FAMILY:-}" ]]; then
    # Subshell: os-release assigns NAME, ID, VERSION... which must not leak into the
    # caller's shell. ID_LIKE goes last because it may hold several words.
    read -r OS_ID OS_VERSION OS_LIKE < <(
        # shellcheck disable=SC1091
        . /etc/os-release 2>/dev/null
        echo "${ID:-unknown} ${VERSION_ID:-0} ${ID_LIKE:-}"
    )
    case " ${OS_ID} ${OS_LIKE} " in
        *" debian "* | *" ubuntu "*)               OS_FAMILY=debian ;;
        *" rhel "* | *" fedora "* | *" centos "*)  OS_FAMILY=rhel ;;
        *)                                         OS_FAMILY=unknown ;;
    esac
    unset OS_LIKE
fi
OS_ID="${OS_ID:-unknown}"
OS_VERSION="${OS_VERSION:-0}"
# @const OS_MAJOR  Major release number: 22 for Ubuntu 22.04, 9 for Rocky 9.4.
OS_MAJOR="${OS_MAJOR:-${OS_VERSION%%.*}}"

# @const PKG_MGR  The system package manager, by family: apt (debian) or dnf (rhel).
case "$OS_FAMILY" in
    debian) PKG_MGR="${PKG_MGR:-apt}" ;;
    rhel)   PKG_MGR="${PKG_MGR:-dnf}" ;;
    *)      PKG_MGR="${PKG_MGR:-}" ;;
esac

# @const SYS_BASHRC  System-wide bashrc read by every interactive bash: where the
#                    dotfiles hook lives. Debian/Ubuntu and RHEL name it differently.
case "$OS_FAMILY" in
    debian) SYS_BASHRC="${SYS_BASHRC:-/etc/bash.bashrc}" ;;
    *)      SYS_BASHRC="${SYS_BASHRC:-/etc/bashrc}" ;;
esac

# @const SUDO  Prefix for commands that need root: empty when already root (cron,
#              deploy, a root shell), "sudo" otherwise. Minimal images and containers
#              may have no sudo binary at all, which is why root must not call it.
#              Use it unquoted: `$SUDO systemctl restart nginx`.
if (( EUID == 0 )); then SUDO=""; else SUDO="sudo"; fi

# @name os_supported
# @description Succeed on a supported distro and release: Ubuntu 20.04+, Debian 11+,
#              or the RHEL family 9+ (RHEL, Rocky, Alma). Deploy refuses otherwise;
#              interactive helpers do not check, they may well work further back.
# @example os_supported || log_warn "Untested distro: ${OS_ID} ${OS_VERSION}"
os_supported() {
    case "$OS_FAMILY:$OS_ID" in
        debian:ubuntu) (( OS_MAJOR >= 20 )) ;;
        debian:*)      (( OS_MAJOR >= 11 )) ;;
        rhel:*)        (( OS_MAJOR >= 9 )) ;;
        *)             return 1 ;;
    esac
}

# ##############################################################################
# @section Paths
# @description Where each part of the dotfiles is deployed. One definition, read by
#              the deploy modules (which write there) and by runtime helpers (which
#              read there), so the two can never disagree.
# ##############################################################################

# @const ALIAS_DIR         This library, deployed (configs/alias).
ALIAS_DIR="${ALIAS_DIR:-/etc/profile.d/.alias}"
# @const SBIN_DIR          Root-only maintenance scripts (configs/sbin).
SBIN_DIR="${SBIN_DIR:-/usr/local/sbin}"
# @const LOGROTATE_DIR     logrotate drop-ins (configs/logrotate.d).
LOGROTATE_DIR="${LOGROTATE_DIR:-/etc/logrotate.d}"
# @const CRON_DIR          cron drop-ins (configs/cron.d).
CRON_DIR="${CRON_DIR:-/etc/cron.d}"
# @const DOTFILES_LOG_DIR  Logs of the maintenance scripts and of deploy runs. Its own
#                          root-owned directory: Ubuntu's /var/log is group-writable
#                          (root:syslog 775), and logrotate refuses to rotate there
#                          without a `su` directive.
DOTFILES_LOG_DIR="${DOTFILES_LOG_DIR:-/var/log/dotfiles}"

# ##############################################################################
# @section Defaults
# @description Shared tunables consumed by the feature modules. Each is overridable:
#              set it in .bash_local, export it, or pass the matching per-call flag.
# ##############################################################################

# @const NOW_FMT  strftime format for log timestamps and the `now` alias,
#                 e.g. 2026-07-03 08:45:02.
NOW_FMT="${NOW_FMT:-+%Y-%m-%d %H:%M:%S}"

# @const GIT_REMOTE       Remote the git helpers push to and fetch from.
GIT_REMOTE="${GIT_REMOTE:-origin}"
# @const GIT_MAIN_BRANCH  Integration branch: gpm / gswp pull it, gcmb compares to it.
GIT_MAIN_BRANCH="${GIT_MAIN_BRANCH:-main}"

# @const PKG_DEFAULT_MANAGER  Manager the pkg_* family uses when -m is omitted.
PKG_DEFAULT_MANAGER="${PKG_DEFAULT_MANAGER:-${PKG_MGR:-apt}}"

# @const PKG_MANAGERS_HELP  Display-only list for usage messages. The authoritative
#                           list is the per-manager case arms in .bash_pkg.
PKG_MANAGERS_HELP="apt|dnf|pip|pnpm|npm|go|cargo"

# @const PKG_NAME_MAP
# @description Package names that differ between managers, keyed "<manager>:<name>".
#              Packages are written once, in their most common spelling, and
#              _pkg_name translates on the way in -- so lists such as SYS_TOOLKIT stay
#              distro-neutral. A name with no entry is used as is. An empty value
#              means "not packaged for this manager": skipped with a warning.
declare -gA PKG_NAME_MAP
PKG_NAME_MAP+=(
    [apt:ShellCheck]=shellcheck
    [apt:gnupg2]=gnupg
    [apt:vim-enhanced]=vim
    [apt:cronie]=cron
    [dnf:build-essential]="gcc gcc-c++ make"
    [dnf:gnupg]=gnupg2
    [dnf:vim]=vim-enhanced
    [dnf:cron]=cronie
    [dnf:shellcheck]=ShellCheck
    [dnf:python3-venv]=""
    [dnf:ufw]=""
    [apt:firewalld]=""
)

# @const SYS_TOOLKIT
# @description Curated everyday CLI tools, installed as a batch by sys_toolkit (and by
#              the packages deploy module). Distro-neutral names: see PKG_NAME_MAP.
#              htop and lnav come from EPEL on the RHEL family; pkg_enable_epel turns
#              it on. shfmt is not packaged for dnf/EPEL -- see ensure_shfmt.
SYS_TOOLKIT=(
    git         # version control (the prompt's git segment needs it too)
    curl        # HTTP client
    jq          # JSON parser (grep/sed for JSON)
    htop        # interactive process monitor
    lnav        # interactive log viewer with SQL queries
)

# @const SYS_TOOLKIT_OPTIONAL
# @description Nice-to-haves kept out of the default set; install with
#              `sys_toolkit -o`, or pick them with `sys_toolkit -m`. gh stores a
#              GitHub token under ~/.config/gh, so it is opt-in on purpose.
SYS_TOOLKIT_OPTIONAL=(
    gh          # GitHub CLI (stores a token under ~/.config/gh)
    yq          # YAML/JSON/TOML parser
    ripgrep     # faster grep, respects .gitignore (binary: rg)
    fd-find     # friendlier find (binary: fd, fdfind on apt)
    fzf         # interactive fuzzy finder (Ctrl-R history)
    bat         # cat with syntax highlighting (binary: batcat on apt)
    ncdu        # interactive disk-usage analyzer
    mtr         # ping + traceroute combined
    tree        # directory tree view
    ShellCheck  # shell script static analysis
)

# @name path_add
# @description Put a directory on PATH once, if it exists. Prepends by default;
#              -a appends. Re-sourcing never duplicates an entry.
# @param -a      flag    Append instead of prepend
# @param $1      string  Directory
# @example path_add "$HOME/.local/bin"
# @example path_add -a /usr/local/go/bin
path_add() {
    local append=0
    [[ "${1:-}" == -a ]] && { append=1; shift; }
    local dir="${1:-}"
    [[ -n "$dir" && -d "$dir" ]] || return 0
    case ":${PATH}:" in
        *":${dir}:"*) return 0 ;;
    esac
    if (( append )); then PATH="${PATH}:${dir}"; else PATH="${dir}:${PATH}"; fi
}

# Toolchain directories, appended so system binaries keep precedence; user bins first.
path_add -a /usr/local/go/bin
path_add -a "$HOME/go/bin"
path_add "$HOME/.local/bin"

# ##############################################################################
# @section Style
# @description ANSI escape sequences, raw (no PS1 \[...\] wrapping): log helpers and
#              menus print them directly. The prompt wraps them itself (.bash_prompt).
# ##############################################################################

declare -gA STYLE
STYLE=(
    # ── reset / font styles ───────────────────────────────────────────────────
    [reset]=$'\e[0m'
    [bold]=$'\e[1m'
    [dim]=$'\e[2m'
    [italic]=$'\e[3m'
    [underline]=$'\e[4m'
    [blink]=$'\e[5m'
    [reverse]=$'\e[7m'
    [strikethrough]=$'\e[9m'

    # ── foreground colors (standard / bright) ─────────────────────────────────
    [fg_black]=$'\e[30m'          [fg_bright_black]=$'\e[90m'
    [fg_red]=$'\e[31m'            [fg_bright_red]=$'\e[91m'
    [fg_green]=$'\e[32m'          [fg_bright_green]=$'\e[92m'
    [fg_yellow]=$'\e[33m'         [fg_bright_yellow]=$'\e[93m'
    [fg_blue]=$'\e[34m'           [fg_bright_blue]=$'\e[94m'
    [fg_magenta]=$'\e[35m'        [fg_bright_magenta]=$'\e[95m'
    [fg_cyan]=$'\e[36m'           [fg_bright_cyan]=$'\e[96m'
    [fg_white]=$'\e[37m'          [fg_bright_white]=$'\e[97m'

    # ── background colors (standard / bright) ─────────────────────────────────
    [bg_black]=$'\e[40m'          [bg_bright_black]=$'\e[100m'
    [bg_red]=$'\e[41m'            [bg_bright_red]=$'\e[101m'
    [bg_green]=$'\e[42m'          [bg_bright_green]=$'\e[102m'
    [bg_yellow]=$'\e[43m'         [bg_bright_yellow]=$'\e[103m'
    [bg_blue]=$'\e[44m'           [bg_bright_blue]=$'\e[104m'
    [bg_magenta]=$'\e[45m'        [bg_bright_magenta]=$'\e[105m'
    [bg_cyan]=$'\e[46m'           [bg_bright_cyan]=$'\e[106m'
    [bg_white]=$'\e[47m'          [bg_bright_white]=$'\e[107m'
)

# ##############################################################################
# @section Log
# @description
#   Semantic status printers with dual output, chosen per call by whether the target
#   fd is a terminal (and NO_COLOR is unset):
#     - Terminal: colored, compact symbol prefix ([V]/[X]/[~]/[i]).
#     - Otherwise (file/pipe/cron): no ANSI, a NOW_FMT timestamp and a word label --
#       "2026-07-03 08:45:02 [ERROR] message" -- readable and greppable by level.
#   NO_COLOR (any value, per no-color.org) forces the plain form on a terminal too.
#   When DOTFILES_LOG_FILE is set, every line is also appended, plain, to that file:
#   deploy runs use this to keep a log while the terminal stays colored.
#   log_err writes stderr; the rest stdout. They never exit -- a helper that exited
#   would close the user's shell. Deploy code wraps them in die() (lib/core.sh).
# ##############################################################################

# @name _log_color
# @description Internal: succeed when output on fd $1 should be colored.
_log_color() { [[ -t "$1" && -z "${NO_COLOR+set}" ]]; }

# @name _log_sink
# @description Internal: append "<ts> [LABEL] message" to DOTFILES_LOG_FILE, if set.
_log_sink() {
    [[ -n "${DOTFILES_LOG_FILE:-}" ]] || return 0
    printf '%s [%s] %s\n' "$(date "$NOW_FMT")" "$1" "$2" >> "$DOTFILES_LOG_FILE" 2>/dev/null
    return 0
}

# @name _log_emit
# @description Internal: one leveled line -- colored "<symbol> <message>" on a
#              terminal, plain "<ts> [LABEL] <message>" otherwise -- plus the sink.
# @param $1 int     fd to test (1 or 2)
# @param $2 string  STYLE key for the symbol
# @param $3 string  Symbol shown on a terminal
# @param $4 string  STYLE key for the message
# @param $5 string  Word label for the plain form
# @param $6.. string Message
_log_emit() {
    local fd="$1" sym_style="$2" symbol="$3" msg_style="$4" label="$5"; shift 5
    if _log_color "$fd"; then
        echo -e "${STYLE[$sym_style]}${symbol}${STYLE[reset]} ${STYLE[$msg_style]}$*${STYLE[reset]}"
    else
        printf '%s [%s] %s\n' "$(date "$NOW_FMT")" "$label" "$*"
    fi
    _log_sink "$label" "$*"
}

# @name log_ok
# @description Success. Terminal: green [V]. Plain: "<ts> [OK] text".
# @example log_ok "nginx reloaded"
log_ok()   { _log_emit 1 bg_green  "[V]" fg_green  OK    "$@"; }

# @name log_err
# @description Error, on stderr. Terminal: red [X]. Plain: "<ts> [ERROR] text".
# @example log_err "Not inside a git repository"
log_err()  { _log_emit 2 bg_red    "[X]" fg_red    ERROR "$@" >&2; }

# @name log_warn
# @description Warning. Terminal: yellow [~]. Plain: "<ts> [WARN] text".
# @example log_warn "Reloading nginx..."
log_warn() { _log_emit 1 bg_yellow "[~]" fg_yellow WARN  "$@"; }

# @name log_info
# @description Info. Terminal: cyan [i]. Plain: "<ts> [INFO] text".
# @example log_info "Switching to branch: main"
log_info() { _log_emit 1 fg_cyan   "[i]" fg_cyan   INFO  "$@"; }

# @name log_step
# @description Progress line, no symbol. Terminal: yellow. Plain: "<ts> [STEP] text".
# @example log_step "Installing jq via apt..."
log_step() {
    if _log_color 1; then
        echo -e "${STYLE[fg_yellow]}$*${STYLE[reset]}"
    else
        printf '%s [STEP] %s\n' "$(date "$NOW_FMT")" "$*"
    fi
    _log_sink STEP "$*"
}

# @name log_head
# @description Section header: bold cyan "─── text ───" (plain when not a terminal).
# @example log_head "Nginx Status"
log_head() {
    if _log_color 1; then
        echo -e "${STYLE[bold]}${STYLE[fg_cyan]}─── $* ───${STYLE[reset]}"
    else
        printf '─── %s ───\n' "$*"
    fi
    _log_sink HEAD "─── $* ───"
}

# @name log_banner
# @description Boxed banner, borders sized to the text. CJK characters render two
#              columns wide but count as one, so their borders run one cell short.
# @example log_banner "Deploy"
log_banner() {
    local text="$*" bar
    bar=$(printf '═%.0s' $(seq 1 $(( ${#text} + 2 ))))
    if _log_color 1; then
        echo -e "${STYLE[bold]}${STYLE[fg_cyan]}╔${bar}╗${STYLE[reset]}"
        echo -e "${STYLE[bold]}${STYLE[fg_cyan]}║ ${text} ║${STYLE[reset]}"
        echo -e "${STYLE[bold]}${STYLE[fg_cyan]}╚${bar}╝${STYLE[reset]}"
    else
        printf '╔%s╗\n║ %s ║\n╚%s╝\n' "$bar" "$text" "$bar"
    fi
    _log_sink BANNER "$text"
}
