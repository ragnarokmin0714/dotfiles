#!/usr/bin/env bash
# @file .bash_env
# @brief Shared bottom layer: ANSI style map, global defaults, log helpers, PS1 builder.
# @description
#   Sourced first, before every other module. Holds what the other modules look up
#   rather than call as a feature:
#     - Style Map   : the STYLE array + styled() (emits PS1-escaped \[...\] codes,
#                     so it is for prompt strings only)
#     - Defaults    : global tunables (NOW_FMT, PKG_*, SYS_TOOLKIT*)
#     - Log Helpers : log_ok / log_err / log_warn / log_info / log_step /
#                     log_head / log_banner -- used by every module
#     - Prompt      : git_prompt (PS1 branch/status segment, NOT a git command)
#                     and build_ps1
#   Feature code does not belong here. Interactive engines (multiselect), package
#   actions, and git commands live in .bash_functions / .bash_pkg / .bash_git.

# ##############################################################################
# @section Style Map
# @description
#   Associative array of all supported ANSI escape sequences for use in PS1.
#   Keys are grouped into: reset, font styles, fg colors, bg colors.
#   All values are wrapped in \[...\] to prevent PS1 line-length miscalculation.
# ##############################################################################

declare -A STYLE=(
    # ── reset ─────────────────────────────────────────────────────────────────
    # [reset]=$'\e[0m'
    # [reset]='\[\e[0m\]'
    [reset]=$'\e[0m'

    # ── font styles ───────────────────────────────────────────────────────────
    [bold]=$'\e[1m'
    [dim]=$'\e[2m'
    [italic]=$'\e[3m'
    [underline]=$'\e[4m'
    [blink]=$'\e[5m'
    [reverse]=$'\e[7m'
    [strikethrough]=$'\e[9m'

    # ── foreground colors (standard) ──────────────────────────────────────────
    [fg_black]=$'\e[30m'
    [fg_red]=$'\e[31m'
    [fg_green]=$'\e[32m'
    [fg_yellow]=$'\e[33m'
    [fg_blue]=$'\e[34m'
    [fg_magenta]=$'\e[35m'
    [fg_cyan]=$'\e[36m'
    [fg_white]=$'\e[37m'

    # ── foreground colors (bright) ────────────────────────────────────────────
    [fg_bright_black]=$'\e[90m'
    [fg_bright_red]=$'\e[91m'
    [fg_bright_green]=$'\e[92m'
    [fg_bright_yellow]=$'\e[93m'
    [fg_bright_blue]=$'\e[94m'
    [fg_bright_magenta]=$'\e[95m'
    [fg_bright_cyan]=$'\e[96m'
    [fg_bright_white]=$'\e[97m'

    # ── background colors (standard) ──────────────────────────────────────────
    [bg_black]=$'\e[40m'
    [bg_red]=$'\e[41m'
    [bg_green]=$'\e[42m'
    [bg_yellow]=$'\e[43m'
    [bg_blue]=$'\e[44m'
    [bg_magenta]=$'\e[45m'
    [bg_cyan]=$'\e[46m'
    [bg_white]=$'\e[47m'

    # ── background colors (bright) ────────────────────────────────────────────
    [bg_bright_black]=$'\e[100m'
    [bg_bright_red]=$'\e[101m'
    [bg_bright_green]=$'\e[102m'
    [bg_bright_yellow]=$'\e[103m'
    [bg_bright_blue]=$'\e[104m'
    [bg_bright_magenta]=$'\e[105m'
    [bg_bright_cyan]=$'\e[106m'
    [bg_bright_white]=$'\e[107m'
)

# ##############################################################################
# @section Defaults
# @description
#   Shared configuration constants consumed by helper functions defined in
#   .bash_functions (sourced after this file). Each is overridable: export the
#   variable before sourcing to change it, or pass the matching per-call flag.
# ##############################################################################

# @const PKG_DEFAULT_MANAGER
# @description Default package manager for pkg_ensure / pkg_remove when -m is omitted.
# @example PKG_DEFAULT_MANAGER=apt   # before sourcing, to default to apt instead
PKG_DEFAULT_MANAGER="${PKG_DEFAULT_MANAGER:-dnf}"

# @const PKG_MANAGERS_HELP
# @description Display-only list of supported managers, interpolated into pkg_*
#              usage messages. NOT a validation source of truth -- the authoritative
#              list is the per-manager case arms in _pkg_is_installed / pkg_ensure /
#              pkg_remove; keep this in sync with them when adding a manager.
PKG_MANAGERS_HELP="apt|dnf|pip|pnpm|npm|go|cargo"

# @const NOW_FMT
# @description strftime format (single source of truth) for the log_* timestamp and
#              the `now` alias in .bash_functions. Used on the log_* non-terminal
#              (file/pipe) path -- e.g. 2026-07-03 08:45:02.
NOW_FMT='+%Y-%m-%d %H:%M:%S'

# @const ALIAS_SRC_DIR
# @description Source of truth (repo copy) that alias-deploy syncs from. Override per checkout.
# @example ALIAS_SRC_DIR=~/dotfiles/.alias   # before sourcing
# $HOME, not ~: tilde expansion does not happen inside double quotes, so the ~ form
# would assign the literal string "~/moneytek/..." and every path built from it fails.
ALIAS_SRC_DIR="${ALIAS_SRC_DIR:-$HOME/moneytek/construction_pmis/.docs/.alias}"

# @const ALIAS_DST_DIR
# @description Live deploy target for alias-deploy, sourced by the startup hook
#              (/etc/bashrc on RHEL/Rocky/Fedora, /etc/bash.bashrc on Debian/Ubuntu).
#              /etc/profile.d is standard across those distros, so the default is
#              portable; override only if a distro puts it elsewhere.
# @example ALIAS_DST_DIR=/usr/local/etc/.alias   # before sourcing
ALIAS_DST_DIR="${ALIAS_DST_DIR:-/etc/profile.d/.alias}"

# @const ALIAS_HOOK_FILE
# @description System-wide bashrc that should source ALIAS_DST_DIR/.bash_aliases.
#              Debian/Ubuntu use /etc/bash.bashrc; RHEL/Rocky/Fedora use /etc/bashrc.
#              Resolved from /etc/os-release (ID/ID_LIKE), NOT the package manager --
#              that is a manual default, not a distro probe. Overridable.
# @example ALIAS_HOOK_FILE=/etc/bash.bashrc   # before sourcing
ALIAS_HOOK_FILE="${ALIAS_HOOK_FILE:-$(
    . /etc/os-release 2>/dev/null
    case " ${ID:-} ${ID_LIKE:-} " in
        *debian*|*ubuntu*) echo /etc/bash.bashrc ;;
        *)                 echo /etc/bashrc ;;
    esac
)}"

# @const SYS_TOOLKIT
# @description Curated everyday CLI tools installed as a batch by sys_toolkit
#              (defined in .bash_functions). Names target dnf/EPEL on this host
#              (all verified present); a few differ on apt (the ShellCheck
#              package is lowercase there) and pkg_ensure's search fallback
#              resolves the miss. Edit this array to change the default set.
#              shfmt is intentionally absent -- it is not packaged for dnf/EPEL;
#              install it via `go install mvdan.cc/sh/v3/cmd/shfmt` or a binary.
SYS_TOOLKIT=(
    jq          # JSON parser (grep/sed for JSON)
    htop        # interactive process monitor
    lnav        # interactive log viewer with SQL queries
)

# @const SYS_TOOLKIT_OPTIONAL
# @description Nice-to-haves kept out of the default set; install with
#              `sys_toolkit -o`. gh stores a GitHub token under ~/.config/gh,
#              so it is opt-in on purpose.
SYS_TOOLKIT_OPTIONAL=(
    gh          # GitHub CLI (stores a token under ~/.config/gh)
    yq          # YAML/JSON/TOML parser
    ripgrep     # faster grep, respects .gitignore (binary: rg)
    fd-find     # friendlier find (binary: fd, fdfind on apt)
    fzf         # interactive fuzzy finder (Ctrl-R history)
    bat         # cat with syntax highlighting (binary: batcat on apt)
    ncdu        # interactive disk-usage analyzer
    mtr         # ping + traceroute combined
    tree        # directory tree view
    ShellCheck  # shell script static analysis
)

# @name styled
# @description Apply STYLE attributes to a text string.
#              Defaults: text="" fg=fg_white bg="" st=""
# @param -t  | --text        string  Text to style (default: "")
# @param -fg | --foreground  string  Foreground color key from STYLE (default: fg_white)
# @param -bg | --background  string  Background color key from STYLE (default: none)
# @param -st | --style       string  Style key from STYLE (default: none)
# @example styled -t "\u"
# @example styled -t "\u" -fg fg_yellow -st bold
# @example styled -t "$ip" -fg fg_bright_white -bg bg_yellow -st bold
# @example styled --text "\W" --foreground fg_bright_white --style dim
styled() {
    local text=""
    local fg="${STYLE[fg_white]}"
    local bg=""
    local st=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t  | --text)       text="$2";           shift 2 ;;
            -fg | --foreground) fg="${STYLE[$2]}";   shift 2 ;;
            -bg | --background) bg="${STYLE[$2]}";   shift 2 ;;
            -st | --style)      st="${STYLE[$2]}";   shift 2 ;;
            *) shift ;;
        esac
    done

#    echo "${st:+${st}}${bg:+${bg}}${fg:+${fg}}${text}${STYLE[reset]}"
    local codes=""
    [[ -n "$st" ]] && codes+="\[${st}\]"
    [[ -n "$bg" ]] && codes+="\[${bg}\]"
    [[ -n "$fg" ]] && codes+="\[${fg}\]"

    echo "${codes}${text}\[${STYLE[reset]}\]"
}
alias styled='styled'

# ##############################################################################
# @section Log Helpers
# @description
#   Semantic status printers with dual output, chosen per call by whether the
#   target fd is a terminal (and NO_COLOR is unset):
#     - Terminal (interactive): colored, compact symbol prefix ([V]/[X]/[~]/[i]).
#     - Non-terminal (redirected to a file/pipe): no ANSI, a NOW_FMT timestamp,
#       and a word-level label -- "2026-07-03 08:45:02 [ERROR] message" -- so
#       captured logs (e.g. sys-maint.log) stay readable and greppable by level.
#   Set NO_COLOR (any value, per no-color.org) to force the plain form even on a
#   terminal. log_err tests/writes stderr; the rest use stdout. Built on
#   echo/printf, not `styled` (which wraps codes in \[...\] for PS1 accounting).
# ##############################################################################

# @name _log_color
# @description Internal: succeed (0) when output on the given fd should be colored
#              -- the fd is a terminal and NO_COLOR is unset. Single switch driving
#              the color / timestamp / label mode for every log_* helper.
# @param $1 int  File descriptor to test (1 = stdout, 2 = stderr)
_log_color() { [[ -t "$1" && -z "${NO_COLOR+set}" ]]; }

# @name _log_emit
# @description Internal: emit one leveled log line. On a terminal, prints the
#              colored "<symbol> <message>"; otherwise the plain, timestamped
#              "<NOW_FMT> [LABEL] <message>". Shared by log_ok/err/warn/info.
# @param $1 int     fd to test for TTY (1 or 2)
# @param $2 string  STYLE key for the symbol (e.g. bg_green)
# @param $3 string  Symbol shown on a terminal (e.g. [V])
# @param $4 string  STYLE key for the message color (e.g. fg_green)
# @param $5 string  Word label used in the plain/log form (e.g. OK)
# @param $6.. string Message text
_log_emit() {
    local fd="$1" sym_style="$2" symbol="$3" msg_style="$4" label="$5"; shift 5
    if _log_color "$fd"; then
        echo -e "${STYLE[$sym_style]}${symbol}${STYLE[reset]} ${STYLE[$msg_style]}$*${STYLE[reset]}"
    else
        printf '%s [%s] %s\n' "$(date "$NOW_FMT")" "$label" "$*"
    fi
}

# @name log_ok
# @description Success line. Terminal: green [V] + green text. Log: "<ts> [OK] text".
# @param $* string  Message text.
# @example log_ok "nginx reloaded successfully"
log_ok()   { _log_emit 1 bg_green  "[V]" fg_green  OK    "$@"; }

# @name log_err
# @description Error line, on stderr. Terminal: red [X] + red text. Log: "<ts> [ERROR] text".
# @param $* string  Message text.
# @example log_err "Not inside a git repository"
log_err()  { _log_emit 2 bg_red    "[X]" fg_red    ERROR "$@" >&2; }

# @name log_warn
# @description Warning line. Terminal: yellow [~] + yellow text. Log: "<ts> [WARN] text".
# @param $* string  Message text.
# @example log_warn "Reloading nginx..."
log_warn() { _log_emit 1 bg_yellow "[~]" fg_yellow WARN  "$@"; }

# @name log_info
# @description Info line. Terminal: cyan [i] + cyan text. Log: "<ts> [INFO] text".
# @param $* string  Message text.
# @example log_info "Switching to branch: ${target_branch}"
log_info() { _log_emit 1 fg_cyan   "[i]" fg_cyan   INFO  "$@"; }

# @name log_step
# @description Progress/step line (no symbol). Terminal: yellow text. Log: "<ts> [STEP] text".
# @param $* string  Message text.
# @example log_step "Installing ${pkg} via ${mgr}..."
log_step() {
    if _log_color 1; then
        echo -e "${STYLE[fg_yellow]}$*${STYLE[reset]}"
    else
        printf '%s [STEP] %s\n' "$(date "$NOW_FMT")" "$*"
    fi
}

# @name log_head
# @description Section header. Terminal: bold cyan ─── text ───. Log: plain ─── text ───.
# @param $* string  Header text.
# @example log_head "Nginx Status"   # prints ─── Nginx Status ───
log_head() {
    if _log_color 1; then
        echo -e "${STYLE[bold]}${STYLE[fg_cyan]}─── $* ───${STYLE[reset]}"
    else
        printf '─── %s ───\n' "$*"
    fi
}

# @name log_banner
# @description Bold cyan boxed banner (colored only on a terminal; plain box in a
#              log). Borders auto-size to the text length. CJK chars render 2 columns
#              wide but count as 1 in ${#text}, so borders run one cell short for CJK.
# @param $* string  Banner text.
# @example log_banner "Deploy"   # prints a 3-line box (╔══╗ / ║ Deploy ║ / ╚══╝)
log_banner() {
    local text="$*"
    local bar
    bar=$(printf '═%.0s' $(seq 1 $(( ${#text} + 2 ))))
    if _log_color 1; then
        # echo -e "${STYLE[bold]}${STYLE[fg_cyan]}╔${bar}╗\n║ ${text} ║\n╚${bar}╝${STYLE[reset]}"
        echo -e "${STYLE[bold]}${STYLE[fg_cyan]}╔${bar}╗${STYLE[reset]}"
        echo -e "${STYLE[bold]}${STYLE[fg_cyan]}║ ${text} ║${STYLE[reset]}"
        echo -e "${STYLE[bold]}${STYLE[fg_cyan]}╚${bar}╝${STYLE[reset]}"
    else
        printf '╔%s╗\n║ %s ║\n╚%s╝\n' "$bar" "$text" "$bar"
    fi
}

# @name git_prompt
# @description Generate Git branch and status symbols for Bash prompt.
#              Symbols:
#              ✔ Clean working tree (nothing to commit)
#              ● Uncommitted changes (modified/deleted in working tree)
#              ✚ Staged changes (index modified)
#              ✖ Merge conflicts
#              ? Untracked files
#              ⚑ Stashed changes
#              ↑ Ahead of remote
#              ↓ Behind remote
#              ⇕ Diverged from remote
#              Detached HEAD shows short commit hash
#              Shows REBASE / MERGE when in progress
git_prompt() {
    command -v git >/dev/null 2>&1 || return
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

    local git_dir
    git_dir=$(git rev-parse --git-dir 2>/dev/null) || return

    local branch symbols=""

    # ── Short commit hash ─────────────────────────────────────────────────────
    local hash
    hash=$(git rev-parse --short=6 HEAD 2>/dev/null) || hash="unknown"

    # ── Detached HEAD ─────────────────────────────────────────────────────────
    if ! branch=$(git symbolic-ref --short HEAD 2>/dev/null); then
        local remote_branch
        remote_branch=$(git branch -r --points-at HEAD 2>/dev/null | grep -v '\->' | sed 's/^ *//' | head -n1)
        if [[ -n "$remote_branch" ]]; then
            branch="$remote_branch"
        else
            branch="detached:$hash"
        fi
    fi

    # ── Rebase / Merge in progress ───────────────────────────────────────────
    if [[ -d "$git_dir/rebase-merge" || -d "$git_dir/rebase-apply" ]]; then
        branch="$branch|REBASE"
    elif [[ -f "$git_dir/MERGE_HEAD" ]]; then
        branch="$branch|MERGE"
    fi

    # ── Git status ───────────────────────────────────────────────────────────
    local status
    status=$(git status --porcelain=v1 --branch 2>/dev/null) || return

    # Staged
    echo "$status" | grep -qE "^[MARCD]." && symbols+="✚"
    # Unstaged modified / deleted
    echo "$status" | grep -qE "^.[MD]"    && symbols+="●"
    # Merge conflicts
    echo "$status" | grep -qE "^(UU|AA|DD|AU|UA|DU|UD)" && symbols+="✖"
    # Untracked
    echo "$status" | grep -qE "^??"       && symbols+="?"

    # ── Ahead / Behind / Diverged ────────────────────────────────────────────
    local ahead behind
    ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null)
    behind=$(git rev-list --count HEAD..@{u} 2>/dev/null)

    if [[ "$ahead" -gt 0 && "$behind" -gt 0 ]]; then
        symbols+="⇕${ahead}↑${behind}↓"
    elif [[ "$ahead" -gt 0 ]]; then
        symbols+=$(styled -t "↑${ahead}" -fg fg_bright_green)
    elif [[ "$behind" -gt 0 ]]; then
        symbols+=$(styled -t "↓${behind}" -fg fg_bright_red)
    fi

    # ── Stash ────────────────────────────────────────────────────────────────
    git stash list --format="%h" 2>/dev/null | grep -q . && symbols+="⚑"

    # ── Clean state ──────────────────────────────────────────────────────────
    [[ -z "$symbols" ]] && symbols=$(styled -t "✔" -fg fg_bright_green)

    local open='('
    branch=$(styled -t "$branch" -fg fg_bright_white -bg bg_yellow -st bold)
    hash=$(styled -t "$hash" -fg fg_yellow -st bold)
    local close=')'
    echo "${open}${branch} ${hash}${symbols:+ ${symbols}}${close}"
}
alias git-prompt='git_prompt'

# @name build_ps1
# @description Build Bash prompt with user@host ip path git-status.
#              Colors: user:red host:yellow ip:cyan path:blue git:magenta
#              Layout example:
#              [root@host:192.168.1.10 ~/project (main abc123 ✔)]#
#              [user@host:192.168.1.10 ~/project (main abc123 ✔)]$
# @symbols
#              \u  → username 使用者名稱
#              \h  → hostname 主機名稱 (short)
#              \H  → hostname 主機名稱 (full)
#              \w  → full working directory path 當前工作目錄完整路徑
#              \W  → current directory name only 當前工作目錄最後一個目錄名稱
#              \$  → # for root, $ for normal users (auto) 普通使用者顯示 $，root 顯示 #
#- \! → 歷史命令編號
#- \d → 日期
#- \t → 時間 (HH:MM:SS)
#- \$ → $ 或 #（依使用者是否為 root）

# @depends     get_ip, git_prompt, STYLE
# @example     PROMPT_COMMAND='build_ps1'   # set in ~/.bashrc
# @example     build_ps1                    # manually trigger once
# @example     build_ps1                    # Directly sets the current shell prompt
# @example     source ~/.bashrc             # Ensures prompt is built on shell start
# @example     export PS1=$(build_ps1)      # Optional: force PS1 assignment manually
# @remark      Prototype: [root@sub construction_pmis]#
#              PS1 → 主要 prompt
#              PS2 → 多行命令續行
#              PS3 → select 命令 prompt
#              PS4 → 除錯 / set -x 前綴
# export PS1='[\u@\h \w]# '
# export PS1='[\u@\h:$get_ip \w ]# '
# export PS1='\[\e[1;32m\][\u@\h\[\e[0m\]:\[\e[1;34m\]$get_ip\[\e[0m\] \[\e[1;33m\]\w\[\e[0m\]]# '
# export PS1='\[\e[1;31m\]\u\[\e[0m\]@\[\e[1;33m\]\h\[\e[0m\] \[\e[1;36m\]$get_ip\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\]\n\$ '
# export PS1=$(build_ps1)
build_ps1() {
    local user=$(styled -t "\u" -fg fg_yellow -st bold)
    local group=$(styled -t "$(id -gn)" -fg fg_bright_yellow)
    local host=$(styled -t "\h" -fg fg_bright_white -st dim)
    local path=$(styled -t "\W" -fg fg_bright_white)

    local ip=$(get_ip)
    [[ -n "$ip" ]] && ip=$(styled -t "$ip" -fg fg_bright_white -bg bg_yellow -st bold)

    local git_prompt=$(echo git_prompt)
    [[ -n "$git_prompt" ]] && git_prompt=$(git_prompt)

    # Prompt symbol (# for root, $ for normal users)
    local symbol
    [[ $EUID -eq 0 ]] && \
        symbol=$(styled -t "#" -fg fg_bright_red -st bold) || \
        symbol=$(styled -t "\$" -fg fg_bright_white -st bold)
    PS1="[${user}($group)@${host}:${ip} ${path} ${git_prompt}]${symbol} "
}