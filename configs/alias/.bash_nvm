#!/usr/bin/env bash
# @file .bash_nvm
# @brief Node via nvm: load it, query, install / uninstall / upgrade versions.
# @description
#   Loads nvm for interactive shells when it is installed under NVM_DIR (the node deploy
#   module installs it there), and puts pnpm's home on PATH. Versions can always be
#   given as arguments; without one, the commands open a menu.
#   Depends on .bash_env (log_*, path_add) and .bash_ui (radioselect, multiselect, ask).

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if ! declare -F nvm >/dev/null && [[ -s "$NVM_DIR/nvm.sh" ]]; then
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh"
    # shellcheck disable=SC1091
    [[ $- == *i* && -s "$NVM_DIR/bash_completion" ]] && . "$NVM_DIR/bash_completion"
fi
export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
path_add "$PNPM_HOME"

# @name _nvm_need
# @description Internal: fail with a hint when nvm is not loaded.
_nvm_need() {
    declare -F nvm >/dev/null && return 0
    log_err "nvm is not installed for $(id -un) (expected ${NVM_DIR}/nvm.sh) -- deploy it: dotfiles node"
    return 1
}

# --- Query / switch ---
alias nvm-ls='nvm list'                  # installed versions
alias nvm-current='nvm current'          # active version
alias nvm-use='nvm use'                  # switch to ./.nvmrc (or the version given)
alias nvm-remote='nvm ls-remote'         # every installable version
alias nvm-lts='nvm ls-remote --lts'      # installable LTS versions
# Disk usage per installed version, plus the download cache
alias nvm-size='du -sh "$NVM_DIR"/versions/node/v* "$NVM_DIR"/.cache 2>/dev/null | sort -k2 -V'
alias nvm-cache-clear='nvm cache clear'  # drop downloaded tarballs; installs are untouched
alias nvm-cc='nvm cache clear'

# @name nvm_find
# @description Is a version installable? Search the remote list for a pattern.
# @param $1 string  Version pattern, e.g. 22.23 or v20
# @example nvm-find 22.23
nvm_find() {
    [[ -n "${1:-}" ]] || { log_err "usage: nvm_find <version-pattern>   e.g. nvm_find 22.23"; return 1; }
    _nvm_need || return 1
    nvm ls-remote | grep -i -- "$1"
}
alias nvm-find='nvm_find'

# @name nvm_install
# @description Install a Node version. Without one, pick from the latest release of
#              each LTS line, or enter any version. Does not change the default.
# @param $1 string  Optional version: v22.23.1, 22, --lts, ...
# @example nvm-i            # menu
# @example nvm-i 22
nvm_install() {
    _nvm_need || return 1
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        ui_tty || { log_err "usage: nvm_install <version>"; return 1; }
        local -a targets=() labels=()
        local line ver name pick
        while IFS= read -r line; do
            ver=$(grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' <<< "$line") || continue
            name=$(grep -oE 'Latest LTS: [A-Za-z]+' <<< "$line")
            targets+=("$ver"); labels+=("${ver}  (${name:-Latest LTS})")
        done < <(nvm ls-remote --lts 2>/dev/null | grep -i 'Latest LTS')
        (( ${#targets[@]} )) || { log_err "Could not fetch the LTS list (network?)"; return 1; }
        radioselect pick "Install which Node version?" -1 "${labels[@]}" "Enter a version..." || { log_info "Cancelled"; return 0; }
        if (( pick == ${#targets[@]} )); then
            ask target "Version (e.g. v22.23.1, 22, --lts)" || return 1
            [[ -n "$target" ]] || { log_info "Cancelled"; return 0; }
        else
            target="${targets[$pick]}"
        fi
    fi
    nvm install "$target" || return 1
    log_ok "Installed ${target} (activate with: nvm use ${target})"
}
alias nvm-install='nvm_install'
alias nvm-i='nvm_install'

# @name nvm_uninstall
# @description Uninstall Node versions: the ones named, or those picked from the
#              installed list (labelled with disk usage). The active version is
#              skipped -- nvm refuses to remove it.
# @param $@ string  Optional versions, e.g. v18.20.4 v20.11.0
# @example nvm-uni          # menu
# @example nvm-uni v18.20.4
nvm_uninstall() {
    _nvm_need || return 1
    local current ver
    current="$(nvm current 2>/dev/null)"
    local -a picked=("$@")

    if (( ${#picked[@]} == 0 )); then
        ui_tty || { log_err "usage: nvm_uninstall <version>..."; return 1; }
        local -a versions labels=()
        local d size sel idx
        mapfile -t versions < <(for d in "$NVM_DIR"/versions/node/v*/; do [[ -d "$d" ]] && basename "$d"; done | sort -V)
        (( ${#versions[@]} )) || { log_err "No versions installed under ${NVM_DIR}/versions/node"; return 1; }
        for ver in "${versions[@]}"; do
            size="$(du -sh "$NVM_DIR/versions/node/$ver" 2>/dev/null | cut -f1)"
            labels+=("${ver}  ${size:-?}$([[ "$ver" == "$current" ]] && echo "  (current)")")
        done
        multiselect sel "Uninstall which Node versions?" "${labels[@]}" || { log_info "Cancelled"; return 0; }
        for idx in $sel; do picked+=("${versions[$idx]}"); done
        (( ${#picked[@]} )) || { log_info "Nothing selected"; return 0; }
    fi

    for ver in "${picked[@]}"; do
        [[ "$ver" == "$current" ]] && { log_warn "Skipping ${ver} (in use)"; continue; }
        if nvm uninstall "$ver"; then log_ok "Uninstalled ${ver}"; else log_err "Failed: ${ver}"; fi
    done
}
alias nvm-uninstall='nvm_uninstall'
alias nvm-uni='nvm_uninstall'

# @name nvm_upgrade
# @description Upgrade Node to a version -- given, from ./.nvmrc, or picked with -m --
#              carrying the global npm packages over, re-enabling corepack, and making
#              it the default. A same-major bump keeps the ABI: node_modules need no
#              rebuild.
# @param -m | --select  flag    Pick from remote versions; $2 filters (default: current major)
# @param $1             string  Target version (default: ./.nvmrc)
# @example nvm-up               # ./.nvmrc
# @example nvm-up 22.23.1
# @example nvm-up -m v20
nvm_upgrade() {
    _nvm_need || return 1
    if [[ "${1:-}" == -m || "${1:-}" == --select ]]; then
        shift
        ui_tty || { log_err "nvm_upgrade -m needs a terminal -- give the version instead"; return 1; }
        local filter="${1:-$(nvm current | grep -oE '^v[0-9]+')}" pick
        local -a versions
        mapfile -t versions < <(nvm ls-remote 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' \
            | grep -E "^${filter}" | awk '!seen[$0]++' | tail -40)
        (( ${#versions[@]} )) || { log_err "No remote versions match '${filter}'"; return 1; }
        radioselect pick "Upgrade to (${filter:-all}, newest last):" $(( ${#versions[@]} - 1 )) "${versions[@]}" \
            || { log_info "Cancelled"; return 0; }
        set -- "${versions[$pick]}"
    fi

    local target="${1:-$(cat .nvmrc 2>/dev/null)}"
    [[ -n "$target" ]] || { log_err "No version given and no ./.nvmrc here -- usage: nvm_upgrade [-m [filter] | version]"; return 1; }
    local from
    from="$(nvm current)"
    nvm install "$target" --reinstall-packages-from="$from" || return 1
    corepack enable 2>/dev/null || log_warn "corepack not available on ${target}"
    nvm alias default "$target" >/dev/null
    log_ok "node $(node -v) (from ${from}); pnpm $(pnpm -v 2>/dev/null || echo '?')"
}
alias nvm-upgrade='nvm_upgrade'
alias nvm-up='nvm_upgrade'
