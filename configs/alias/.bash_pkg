#!/usr/bin/env bash
# @file .bash_pkg
# @brief Packages: check / ensure / remove / batch-install across managers, EPEL,
#        and the curated CLI toolkit.
# @description
#   apt and dnf are the system managers (PKG_MGR picks one per host); pip, pnpm, npm,
#   go and cargo are supported by the single-package helpers. Package names are
#   written once, distro-neutral, and translated through PKG_NAME_MAP (.bash_env).
#   Depends on .bash_env (globals, log_*) and .bash_ui (radioselect, multiselect,
#   confirm).

# @name _pkg_name
# @description Internal: echo the name(s) <manager> knows <package> by -- the
#              PKG_NAME_MAP entry if there is one (possibly several words, possibly
#              empty: not packaged there), else the name unchanged.
# @param $1 string  Manager
# @param $2 string  Distro-neutral package name
# @example _pkg_name dnf build-essential   # -> gcc gcc-c++ make
_pkg_name() {
    local key="$1:$2"
    if [[ -n "${PKG_NAME_MAP[$key]+set}" ]]; then
        echo "${PKG_NAME_MAP[$key]}"
    else
        echo "$2"
    fi
}

# @name _pkg_is_installed
# @description Internal: is a package installed via the given manager? Prints nothing
#              for the answer (the caller reports); only an unusable manager logs.
# @param $1 string  Manager: apt | dnf | pip | pnpm | npm | go | cargo
# @param $2 string  Package name, as that manager knows it
# @param $3 string  Optional "true" for global scope (pnpm/npm)
# @returns 0 installed, 1 not installed, 2 manager unusable
_pkg_is_installed() {
    local mgr="$1" pkg="$2" global_flag="${3:-false}"
    case "$mgr" in
        apt)
            command -v dpkg-query &>/dev/null || { log_err "dpkg-query not found"; return 2; }
            [[ "$(dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null)" == "install ok installed" ]]
            ;;
        dnf)
            command -v rpm &>/dev/null || { log_err "rpm not found"; return 2; }
            rpm -q "$pkg" &>/dev/null
            ;;
        pip)
            command -v pip &>/dev/null || { log_err "pip not found"; return 2; }
            pip show "$pkg" &>/dev/null
            ;;
        pnpm | npm)
            command -v "$mgr" &>/dev/null || { log_err "${mgr} not found"; return 2; }
            if [[ "$global_flag" == true ]]; then "$mgr" list -g "$pkg" &>/dev/null; else "$mgr" list "$pkg" &>/dev/null; fi
            ;;
        go)
            command -v go &>/dev/null || { log_err "go not found"; return 2; }
            command -v "$(basename "${pkg%@*}")" &>/dev/null
            ;;
        cargo)
            command -v cargo &>/dev/null || { log_err "cargo not found"; return 2; }
            cargo install --list 2>/dev/null | grep -q "^${pkg} "
            ;;
        *)
            log_err "Unsupported manager: ${mgr}"
            return 2
            ;;
    esac
}

# @name _pkg_search_select
# @description Internal: search apt/dnf for a query and pick one result from a
#              radioselect menu; echo the pick on stdout (prompts go to stderr, so
#              callers capture it with $(...)). Other managers echo the query as is.
# @returns 0 with the name on stdout; 1 on no match, no terminal, or cancel
_pkg_search_select() {
    local mgr="$1" query="$2"
    local -a candidates=()
    case "$mgr" in
        dnf)
            mapfile -t candidates < <(dnf -q search "$query" 2>/dev/null \
                | grep ' : ' | awk '{ print $1 }' | sed 's/\.[^.]*$//' | sort -u)
            ;;
        apt)
            mapfile -t candidates < <(apt-cache search "$query" 2>/dev/null | awk '{ print $1 }' | sort -u)
            ;;
        *)
            log_warn "search not supported for ${mgr}; using exact name '${query}'" >&2
            echo "$query"
            return 0
            ;;
    esac
    (( ${#candidates[@]} )) || { log_err "No ${mgr} package matches '${query}'"; return 1; }
    ui_tty || { printf '%s\n' "${candidates[@]}" >&2; log_err "Several packages match -- give one exactly"; return 1; }
    local choice
    radioselect choice "Packages matching '${query}' (${mgr}):" -1 "${candidates[@]}" || return 1
    echo "${candidates[$choice]}"
}

# @name _pkg_available
# @description Internal: does apt/dnf know a package by this exact name (installed or
#              installable)? Other managers always answer yes (no search fallback).
_pkg_available() {
    case "$1" in
        dnf) dnf -q info "$2" &>/dev/null ;;
        apt) apt-cache show "$2" &>/dev/null ;;
        *)   return 0 ;;
    esac
}

# @name _pkg_args
# @description Internal: shared option parser for pkg_installed / pkg_ensure /
#              pkg_remove. Sets the caller's locals mgr, pkg, global_flag, yes_flag,
#              search_flag (declared by the caller); returns 1 on a bad option.
#              One parser, so the three can never drift apart in what they accept.
_pkg_args() {
    while (( $# )); do
        case "$1" in
            -m | --manager) mgr="${2:-}"; shift ;;
            -p | --package) pkg="${2:-}"; shift ;;
            -g | --global)  global_flag=true ;;
            -s | --search)  search_flag=true ;;
            -y | --yes)     yes_flag=true ;;
            -*) log_err "Unknown option: $1"; return 1 ;;
            *)  [[ -z "$pkg" ]] && pkg="$1" ;;
        esac
        shift
    done
    case "$mgr" in apt | dnf) pkg=$(_pkg_name "$mgr" "$pkg") ;; esac
    return 0
}

# @name pkg_installed
# @description Report whether a package is installed.
# @param -m | --manager string  apt | dnf | pip | pnpm | npm | go | cargo
#                                (default: PKG_DEFAULT_MANAGER)
# @param -p | --package string  Package (or give it positionally)
# @param -g | --global  flag    pnpm/npm global scope
# @param -s | --search  flag    Search apt/dnf and pick from a menu
# @returns 0 installed, 1 not, 2 manager unusable
# @example pi git
# @example pkg_installed -m npm -g eslint
pkg_installed() {
    local mgr="$PKG_DEFAULT_MANAGER" pkg="" global_flag=false yes_flag=false search_flag=false
    _pkg_args "$@" || return 1
    [[ -n "$pkg" ]] || { log_err "usage: pkg_installed [-m <${PKG_MANAGERS_HELP}>] [-g] [-s] <package>"; return 1; }
    if [[ "$search_flag" == true ]]; then pkg=$(_pkg_search_select "$mgr" "$pkg") || return 1; fi

    _pkg_is_installed "$mgr" "$pkg" "$global_flag"
    case $? in
        0) log_ok "${pkg} is installed (${mgr})"; return 0 ;;
        1) log_err "${pkg} is not installed (${mgr})"; return 1 ;;
        *) return 2 ;;
    esac
}
alias pkg-installed='pkg_installed'
alias pi='pkg_installed'

# @name pkg_ensure
# @description Make sure one package is installed: report it if it is, else offer to
#              install it. A name apt/dnf does not know opens a search menu (or with
#              -s, always) -- except under -y, which never asks anything: an unknown
#              name is then an error, to be fixed with a PKG_NAME_MAP entry.
# @param -m | --manager string  apt | dnf | pip | pnpm | npm | go | cargo
# @param -p | --package string  Package (or give it positionally)
# @param -g | --global  flag    pnpm/npm global install
# @param -y | --yes     flag    Install without asking
# @param -s | --search  flag    Search apt/dnf and pick from a menu
# @example pe jq
# @example pkg_ensure -m apt -y git
# @example pkg_ensure -m pnpm -g typescript
# @example pkg_ensure -m go golang.org/x/tools/cmd/goimports
pkg_ensure() {
    local mgr="$PKG_DEFAULT_MANAGER" pkg="" global_flag=false yes_flag=false search_flag=false
    _pkg_args "$@" || return 1
    [[ -n "$pkg" ]] || { log_err "usage: pkg_ensure [-m <${PKG_MANAGERS_HELP}>] [-g] [-y] [-s] <package>"; return 1; }
    if [[ "$search_flag" == true ]]; then pkg=$(_pkg_search_select "$mgr" "$pkg") || return 1; fi

    _pkg_is_installed "$mgr" "$pkg" "$global_flag"
    local rc=$?
    (( rc == 2 )) && return 2
    (( rc == 0 )) && { log_ok "${pkg} is already installed (${mgr})"; return 0; }

    if [[ "$search_flag" != true ]] && ! _pkg_available "$mgr" "$pkg"; then
        [[ "$yes_flag" == true ]] && { log_err "'${pkg}' is unknown to ${mgr} -- add a PKG_NAME_MAP entry"; return 1; }
        log_warn "'${pkg}' not found in ${mgr}; searching for similar packages..."
        pkg=$(_pkg_search_select "$mgr" "$pkg") || return 1
        _pkg_is_installed "$mgr" "$pkg" "$global_flag" && { log_ok "${pkg} is already installed (${mgr})"; return 0; }
    fi

    log_warn "${pkg} is not installed (${mgr})"
    [[ "$yes_flag" == true ]] || confirm "Install ${pkg} now via ${mgr}?" || { log_step "Skipped ${pkg}"; return 1; }

    log_step "Installing ${pkg} via ${mgr}..."
    local -a g=()
    [[ "$global_flag" == true ]] && g=(-g)
    case "$mgr" in
        apt)   $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y "$pkg" ;;
        dnf)   $SUDO dnf install -y "$pkg" ;;
        pip)   pip install "$pkg" ;;
        pnpm)  pnpm add "${g[@]}" "$pkg" ;;
        npm)   npm install "${g[@]}" "$pkg" ;;
        go)    go install "${pkg%@*}@latest" ;;
        cargo) cargo install "$pkg" ;;
    esac || { log_err "Failed to install ${pkg}"; return 1; }
    log_ok "${pkg} installed"
}
alias pkg-ensure='pkg_ensure'
alias pe='pkg_ensure'

# @name pkg_remove
# @description Remove one package if installed, after a confirmation (-y skips it).
# @param -m | --manager string  apt | dnf | pip | pnpm | npm | go | cargo
# @param -p | --package string  Package (or give it positionally)
# @param -g | --global  flag    pnpm/npm global package
# @param -y | --yes     flag    Remove without asking
# @param -s | --search  flag    Search apt/dnf and pick from a menu
# @example prm shfmt -y
# @example pkg_remove -m npm -g eslint
pkg_remove() {
    local mgr="$PKG_DEFAULT_MANAGER" pkg="" global_flag=false yes_flag=false search_flag=false
    _pkg_args "$@" || return 1
    [[ -n "$pkg" ]] || { log_err "usage: pkg_remove [-m <${PKG_MANAGERS_HELP}>] [-g] [-y] [-s] <package>"; return 1; }
    if [[ "$search_flag" == true ]]; then pkg=$(_pkg_search_select "$mgr" "$pkg") || return 1; fi

    _pkg_is_installed "$mgr" "$pkg" "$global_flag"
    local rc=$?
    (( rc == 2 )) && return 2
    (( rc == 0 )) || { log_ok "${pkg} is not installed (${mgr}), nothing to remove"; return 0; }

    [[ "$yes_flag" == true ]] || confirm "Remove ${pkg} via ${mgr}?" || { log_step "Kept ${pkg}"; return 1; }
    log_step "Removing ${pkg} via ${mgr}..."
    local -a g=()
    [[ "$global_flag" == true ]] && g=(-g)
    case "$mgr" in
        apt)   $SUDO env DEBIAN_FRONTEND=noninteractive apt-get remove -y "$pkg" ;;
        dnf)   $SUDO dnf remove -y "$pkg" ;;
        pip)   pip uninstall -y "$pkg" ;;
        pnpm)  pnpm remove "${g[@]}" "$pkg" ;;
        npm)   npm uninstall "${g[@]}" "$pkg" ;;
        go)    rm -f "$(go env GOPATH)/bin/$(basename "${pkg%@*}")" ;;
        cargo) cargo uninstall "$pkg" ;;
    esac || { log_err "Failed to remove ${pkg}"; return 1; }
    log_ok "${pkg} removed"
}
alias pkg-remove='pkg_remove'
alias prm='pkg_remove'

# @name pkg_install
# @description Install system packages in one apt/dnf transaction, non-interactively:
#              names are translated through PKG_NAME_MAP, the ones already installed
#              are left out, and nothing asks. What scripts and deploy modules use;
#              pkg_ensure is the interactive one-package counterpart. Refreshes a
#              missing or day-old apt index first, since a fresh image has none.
# @param -m | --manager  string  apt | dnf (default: PKG_MGR)
# @param -n | --dry-run  flag    Print the command, run nothing
# @param $@              string  Packages, distro-neutral names
# @example pkg_install git jq build-essential
# @example pkg_install -n cron      # dnf: would install cronie
pkg_install() {
    local mgr="$PKG_MGR" dry=0 usage="usage: pkg_install [-m apt|dnf] [-n] <package>..."
    local -a wanted=()
    while (( $# )); do
        case "$1" in
            -m | --manager) mgr="${2:-}"; shift ;;
            -n | --dry-run) dry=1 ;;
            -h | --help)    echo "$usage"; return 0 ;;
            -*) log_err "Unknown option: $1 -- ${usage}"; return 1 ;;
            *)  wanted+=("$1") ;;
        esac
        shift
    done
    (( ${#wanted[@]} )) || { log_err "$usage"; return 1; }
    case "$mgr" in
        apt | dnf) ;;
        *) log_err "pkg_install handles apt and dnf -- for ${mgr:-?} use pkg_ensure -m"; return 1 ;;
    esac

    # A dry run of the other family (OS_FAMILY preset) has no rpm/dpkg to ask:
    # then everything counts as missing.
    local query=1
    command -v "$([[ "$mgr" == apt ]] && echo dpkg-query || echo rpm)" &>/dev/null || query=0
    (( query || dry )) || { log_err "${mgr} is not usable on this host"; return 1; }

    local -a missing=() names
    local w n
    for w in "${wanted[@]}"; do
        read -ra names <<< "$(_pkg_name "$mgr" "$w")"
        (( ${#names[@]} )) || { log_info "${w}: not needed on ${mgr} (PKG_NAME_MAP) -- skipped"; continue; }
        for n in "${names[@]}"; do
            (( query )) && _pkg_is_installed "$mgr" "$n" && continue
            missing+=("$n")
        done
    done
    (( ${#missing[@]} )) || { log_ok "Already installed: ${wanted[*]}"; return 0; }

    local -a cmd
    case "$mgr" in
        apt) cmd=(env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}") ;;
        dnf) cmd=(dnf install -y "${missing[@]}") ;;
    esac
    if (( dry )); then
        log_info "Dry run -- would run: ${SUDO:+$SUDO }${cmd[*]}"
        return 0
    fi
    if [[ "$mgr" == apt ]] && ! find /var/lib/apt/lists -maxdepth 1 -name '*_Packages' -mmin -1440 2>/dev/null | grep -q .; then
        log_step "Refreshing the apt index..."
        $SUDO apt-get update -qq || { log_err "apt-get update failed"; return 1; }
    fi
    log_step "Installing via ${mgr}: ${missing[*]}"
    $SUDO "${cmd[@]}" || { log_err "Install failed: ${missing[*]}"; return 1; }
    log_ok "Installed: ${missing[*]}"
}
alias pkg-install='pkg_install'

# @name pkg_enable_epel
# @description Enable EPEL on the RHEL family -- where htop, lnav and friends come
#              from -- together with CRB, which EPEL packages depend on. Rocky and
#              Alma ship both in their own repos; RHEL enables CRB through
#              subscription-manager and installs EPEL from Fedora's release rpm.
#              A no-op elsewhere, and when EPEL is already there.
# @param -n | --dry-run  flag  Print the commands, run nothing
# @example pkg_enable_epel
pkg_enable_epel() {
    local dry=0
    case "${1:-}" in
        -n | --dry-run) dry=1 ;;
        -h | --help)    echo "usage: pkg_enable_epel [-n]"; return 0 ;;
    esac
    [[ "$OS_FAMILY" == rhel ]] || { log_info "EPEL is for the RHEL family -- nothing to do on ${OS_ID}"; return 0; }
    if command -v rpm &>/dev/null && rpm -q epel-release &>/dev/null; then
        log_ok "EPEL already enabled"
        return 0
    fi
    local -a steps
    if [[ "$OS_ID" == rhel ]]; then
        steps=("subscription-manager repos --enable codeready-builder-for-rhel-${OS_MAJOR}-$(uname -m)-rpms"
               "dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-${OS_MAJOR}.noarch.rpm")
    else
        steps=("dnf install -y dnf-plugins-core"
               "dnf config-manager --set-enabled crb"
               "dnf install -y epel-release")
    fi
    if (( dry )); then
        log_info "Dry run -- would run:"
        printf "  ${SUDO:+$SUDO }%s\n" "${steps[@]}"
        return 0
    fi
    local step
    local -a argv
    for step in "${steps[@]}"; do
        read -ra argv <<< "$step"
        log_step "Running: ${step}"
        $SUDO "${argv[@]}" || { log_err "Failed: ${step}"; return 1; }
    done
    log_ok "EPEL and CRB enabled"
}
alias pkg-enable-epel='pkg_enable_epel'

# @name pkg_unused
# @description Report installed rpm packages that have never been used, ranked by
#              size. Usage comes from atime (rpm installs files with atime ==
#              mtime, so a later atime means something read them); the safety call
#              comes from a `dnf remove --assumeno` pass on each candidate. Both
#              live in pkg_usage.py next to this file -- see its header for the
#              blind spots, which is required reading before deleting anything.
#              Only DELETABLE rows are offered for removal; REVIEW rows are listed
#              with the reason but never selectable, because idle packages can
#              still be load-bearing (@core members, rescue tools, a service whose
#              binaries systemd hides from atime).
# @param -s | --min-size number  Size floor in MB: hides smaller rows and bounds
#                                 the dnf pass, which costs ~0.5s per candidate
#                                 (default: 5)
# @param -a | --all      flag    List every package, not just candidates
# @param -q | --quick    flag    Skip the dnf pass -- ~1s, but no safety verdict
# @example pun                   # 'pun' alias; candidates over 5 MB
# @example pkg_unused -s 50      # only the big ones
# @example pkg_unused -a -q      # full inventory, no dnf pass
pkg_unused() {
    local min_size=5 show_all=false quick=false
    local engine="${BASH_SOURCE[0]%/*}/pkg_usage.py"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            # A bare -s would leave `shift 2` with nothing to shift, and bash
            # then leaves $# alone -- the while loop spins forever.
            -s | --min-size)
                [[ -n "${2:-}" ]] || { log_err "Missing value for $1"; return 1; }
                min_size="$2"; shift 2 ;;
            -a | --all)      show_all=true; shift ;;
            -q | --quick)    quick=true; shift ;;
            *) log_err "Usage: pkg_unused [-s <MB>] [-a] [-q]"; return 1 ;;
        esac
    done

    command -v python3 &>/dev/null || { log_err "python3 not found"; return 1; }
    command -v dnf &>/dev/null || { log_err "pkg_unused is dnf/rpm only"; return 1; }
    [[ -f "$engine" ]] || { log_err "Engine not found: ${engine} -- put pkg_usage.py in configs/alias/ and redeploy (dotfiles shell)"; return 1; }

    local -a flags=(--min-size "$min_size")
    [[ "$quick" == true ]] && flags+=(--no-dry-run)

    # The dnf pass waits on any other dnf holding the lock -- measured at 166s
    # against a running makecache -- so say why it is slow before it is slow.
    if [[ "$quick" != true ]] && pgrep -x dnf &>/dev/null; then
        log_warn "Another dnf is running; the safety pass will wait on its lock"
    fi

    if [[ "$quick" == true ]]; then
        log_step "Scanning installed packages (no dnf pass -- IDLE rows are ungraded)..."
    else
        log_step "Scanning installed packages (dnf pass on candidates over ${min_size} MB)..."
    fi
    local tsv
    tsv=$(python3 "$engine" "${flags[@]}") || { log_err "Scan failed"; return 1; }

    # The engine already emits largest-first, so no re-sorting here. IDLE only
    # shows up under -q, where the dnf pass that would grade it never ran.
    echo ""
    awk -F'\t' -v all="$show_all" -v quick="$quick" -v minmb="$min_size" \
        'NR > 1 && $2 + 0 >= minmb &&
         (all == "true" || $1 == "DELETABLE" || $1 == "REVIEW" ||
          (quick == "true" && $1 == "IDLE")) {
            # "-" rather than "": column -t merges repeated separators, so an
            # empty cell would slide the note into the deps column.
            printf "%s\t%s MB\t%s\t%s\t%s\n", $1, $2, $5, ($4 > 0 ? "+" $4 " deps" : "-"), $6
        }' <<< "$tsv" | column -t -s$'\t'

    # ── Offer removal of the safe ones ────────────────────────────────────────
    local -a names=() labels=()
    while IFS=$'\t' read -r status mb _ _ name note; do
        [[ "$status" == "DELETABLE" ]] || continue
        names+=("$name")
        labels+=("$(printf '%8.1f MB  %-24s %s' "$mb" "$name" "$note")")
    done < <(tail -n +2 <<< "$tsv")

    if [[ ${#names[@]} -eq 0 ]]; then
        echo ""
        log_ok "Nothing safe enough to suggest removing"
        return 0
    fi

    echo ""
    log_warn "Read pkg_usage.py's blind spots before removing -- a package updated"
    log_warn "recently looks unused even if you use it daily."
    confirm "Pick packages to remove?" || { log_step "Left everything installed"; return 0; }

    local PICKS
    multiselect PICKS "Remove which packages?" "${labels[@]}" || {
        log_step "Cancelled"; return 0
    }
    [[ -n "$PICKS" ]] || { log_step "Nothing selected"; return 0; }

    local i
    for i in $PICKS; do
        pkg_remove -m dnf -p "${names[$i]}" -y
    done
}
alias pkg-unused='pkg_unused'
alias pun='pkg_unused'

# =========================
# --- Toolkit ---
# =========================

# @name _sys_toolkit_menu
# @description Internal: `sys_toolkit -m`. One label per package -- installed ones are
#              offered for removal, missing ones for install -- picked with
#              multiselect, then applied with pkg_remove -y / pkg_install.
# @param $@ string  Distro-neutral package names
_sys_toolkit_menu() {
    local -a pkgs=("$@") installed=() labels=()
    local i name tag
    for i in "${!pkgs[@]}"; do
        name=$(_pkg_name "$PKG_MGR" "${pkgs[$i]}")
        if [[ -n "$name" ]] && _pkg_is_installed "$PKG_MGR" "${name%% *}"; then
            installed[i]=true;  tag="(installed → remove)"
        else
            installed[i]=false; tag="(missing → install)"
        fi
        printf -v "labels[$i]" "%-11s %s" "${pkgs[$i]}" "$tag"
    done

    local selected
    multiselect selected "Toolkit (${PKG_MGR})" "${labels[@]}" || { log_info "Cancelled"; return 0; }
    local -a picks
    read -ra picks <<< "$selected"
    (( ${#picks[@]} )) || { log_info "No packages selected"; return 0; }

    local -a failed=() add=()
    local idx
    for idx in "${picks[@]}"; do
        if [[ "${installed[$idx]}" == true ]]; then
            pkg_remove -m "$PKG_MGR" -y "${pkgs[$idx]}" || failed+=("${pkgs[$idx]}")
        else
            add+=("${pkgs[$idx]}")
        fi
    done
    (( ${#add[@]} )) && { pkg_install "${add[@]}" || failed+=("${add[@]}"); }
    (( ${#failed[@]} )) && { log_err "Toolkit: failed -> ${failed[*]}"; return 1; }
    log_ok "Toolkit: applied ${#picks[@]} change(s)"
}

# @name sys_toolkit
# @description Install the curated CLI toolkit (SYS_TOOLKIT, .bash_env) with the
#              system package manager, in one transaction. On the RHEL family, enable
#              EPEL first (pkg_enable_epel) -- htop and lnav live there.
# @param -o | --optional  flag  Also install SYS_TOOLKIT_OPTIONAL (gh, ripgrep, ...)
# @param -m | --menu      flag  Pick tools to install / remove from the full set
# @param -n | --dry-run   flag  Print what would be installed, change nothing
# @example toolkit           # default set
# @example toolkit -o        # with the optional tools
# @example toolkit -m        # menu
sys_toolkit() {
    local optional=0 menu=0 dry=0 usage="usage: sys_toolkit [-o] [-m] [-n]"
    while (( $# )); do
        case "$1" in
            -o | --optional) optional=1 ;;
            -m | --menu)     menu=1 ;;
            -n | --dry-run)  dry=1 ;;
            -h | --help)     echo "$usage"; return 0 ;;
            *) log_err "Unknown option: $1 -- ${usage}"; return 1 ;;
        esac
        shift
    done
    [[ -n "$PKG_MGR" ]] || { log_err "No supported package manager (OS family: ${OS_FAMILY})"; return 1; }
    local -a tools=("${SYS_TOOLKIT[@]}")
    (( optional || menu )) && tools+=("${SYS_TOOLKIT_OPTIONAL[@]}")

    if (( menu )); then
        ui_tty || { log_err "The toolkit menu needs a terminal -- use sys_toolkit [-o]"; return 1; }
        _sys_toolkit_menu "${tools[@]}"
        return
    fi
    local -a n=()
    (( dry )) && n=(-n)
    pkg_enable_epel "${n[@]}" || return 1
    pkg_install "${n[@]}" "${tools[@]}"
}
alias sys-toolkit='sys_toolkit'
alias toolkit='sys_toolkit'

# @name ensure_shfmt
# @description Install shfmt from its official GitHub release binary into
#              /usr/local/bin, since shfmt is not packaged for dnf/EPEL. Resolves
#              the latest version, downloads the matching linux binary plus the
#              release checksum file, verifies the SHA-256, then installs it mode
#              755. Idempotent: skips if shfmt is already on PATH unless -f is given.
# @param -f | --force  flag  Reinstall even if shfmt is already present (upgrade)
# @example ensure_shfmt        # install shfmt if missing
# @example ensure_shfmt -f     # force reinstall / upgrade to latest
ensure_shfmt() {
    local force=false
    [[ "${1:-}" == "-f" || "${1:-}" == "--force" ]] && force=true

    if [[ "$force" != true ]] && command -v shfmt &>/dev/null; then
        log_ok "shfmt already installed: $(shfmt --version 2>/dev/null) ($(command -v shfmt))"
        return 0
    fi
    command -v curl &>/dev/null || { log_err "curl is required to install shfmt"; return 1; }

    # Map uname arch to shfmt's release naming.
    local arch
    case "$(uname -m)" in
        x86_64)  arch=amd64 ;;
        aarch64) arch=arm64 ;;
        *) log_err "Unsupported architecture: $(uname -m)"; return 1 ;;
    esac

    # Resolve the latest release tag (e.g. v3.10.0) from the GitHub API.
    local tag
    tag=$(curl -fsSL https://api.github.com/repos/mvdan/sh/releases/latest \
        | grep -oP '"tag_name":\s*"\K[^"]+')
    if [[ -z "$tag" ]]; then
        log_err "Failed to resolve latest shfmt version"
        return 1
    fi

    local asset="shfmt_${tag}_linux_${arch}"
    local base="https://github.com/mvdan/sh/releases/download/${tag}"
    local tmp; tmp=$(mktemp -d) || { log_err "mktemp failed"; return 1; }

    log_step "Downloading ${asset} (${tag}) and verifying checksum..."
    if curl -fsSL "${base}/${asset}" -o "${tmp}/${asset}" \
        && curl -fsSL "${base}/sha256sums.txt" -o "${tmp}/sums.txt" \
        && (cd "$tmp" && grep " ${asset}\$" sums.txt | sha256sum -c --status -) \
        && $SUDO install -m 755 "${tmp}/${asset}" /usr/local/bin/shfmt; then
        log_ok "shfmt installed: $(shfmt --version 2>/dev/null) (/usr/local/bin/shfmt)"
        rm -rf "$tmp"
    else
        log_err "Failed to install shfmt ${tag} (download/checksum/install error)"
        rm -rf "$tmp"
        return 1
    fi
}
alias ensure-shfmt='ensure_shfmt'
