#!/usr/bin/env bash
# @file .bash_pkg
# @brief Package management and curated CLI toolkit helpers.
# @description
#   Everything package-shaped: the pkg_* family (installed / ensure / remove
#   across apt, dnf, pip, pnpm, npm, go, cargo) and the curated toolkit
#   (sys_toolkit, ensure_shfmt).
#   Split out of .bash_functions to keep one domain per file (like .bash_git /
#   .bash_nginx).
#   Depends on .bash_env (sourced first) for log_* helpers, the STYLE map, and the
#   PKG_* / SYS_TOOLKIT* configuration constants; and on .bash_functions for
#   _pkg_manager (system apt/dnf detection, shared with sys_update) and the shared
#   multiselect engine.

# =========================
# --- Package Utilities ---
# =========================

# @name _pkg_is_installed
# @description Internal: detect whether a package is installed via the given manager.
#              Pure detection -- prints nothing for the installed/not-installed
#              answer (caller logs). Only an unusable manager (binary missing or
#              unsupported) logs an error and returns 2. Shared by pkg_installed,
#              pkg_ensure, and pkg_remove to keep one source of truth for detection.
# @param $1 string  Manager: apt | dnf | pip | pnpm | npm | go | cargo
# @param $2 string  Package name
# @param $3 string  Optional "true" to check global scope (pip/pnpm/npm)
# @returns 0 installed, 1 not installed, 2 manager unusable
_pkg_is_installed() {
    local mgr="$1" pkg="$2" global_flag="${3:-false}"

    case "$mgr" in
        apt)
            command -v apt &>/dev/null || { log_err "apt not found"; return 2; }
            dpkg -l "$pkg" 2>/dev/null | grep -q "^ii"
            ;;
        dnf)
            command -v dnf &>/dev/null || { log_err "dnf not found"; return 2; }
            dnf list installed "$pkg" &>/dev/null
            ;;
        pip)
            command -v pip &>/dev/null || { log_err "pip not found"; return 2; }
            pip show "$pkg" &>/dev/null
            ;;
        pnpm)
            command -v pnpm &>/dev/null || { log_err "pnpm not found"; return 2; }
            if [[ "$global_flag" == true ]]; then
                pnpm list -g "$pkg" &>/dev/null
            else
                pnpm list "$pkg" &>/dev/null
            fi
            ;;
        npm)
            command -v npm &>/dev/null || { log_err "npm not found"; return 2; }
            if [[ "$global_flag" == true ]]; then
                npm list -g "$pkg" &>/dev/null
            else
                npm list "$pkg" &>/dev/null
            fi
            ;;
        go)
            command -v go &>/dev/null || { log_err "go not found"; return 2; }
            command -v "$(basename "$pkg")" &>/dev/null
            ;;
        cargo)
            command -v cargo &>/dev/null || { log_err "cargo not found"; return 2; }
            cargo install --list 2>/dev/null | grep -q "^${pkg} "
            ;;
        *)
            log_err "Unsupported manager: ${mgr}"
            return 2
            ;;
    esac
}

# @name _pkg_search_select
# @description Internal: search apt/dnf for a query and present a radioselect
#              menu, echoing the chosen package name to stdout. Only apt and dnf
#              support package search; other managers return the query unchanged.
#              All prompts/messages go to stderr so the caller can capture the
#              choice via $(...) -- only the final package name reaches stdout.
# @param $1 string  Manager
# @param $2 string  Search query
# @returns 0 with chosen name on stdout; 1 on no match, unusable tool, or cancel
_pkg_search_select() {
    local mgr="$1" query="$2"
    local -a candidates=()

    case "$mgr" in
        dnf)
            command -v dnf &>/dev/null || { log_err "dnf not found"; return 1; }
            mapfile -t candidates < <(
                dnf -q search "$query" 2>/dev/null \
                    | grep ' : ' | awk '{ print $1 }' | sed 's/\.[^.]*$//' | sort -u
            )
            ;;
        apt)
            command -v apt-cache &>/dev/null || { log_err "apt-cache not found"; return 1; }
            mapfile -t candidates < <(
                apt-cache search "$query" 2>/dev/null | awk '{ print $1 }' | sort -u
            )
            ;;
        *)
            log_warn "search not supported for ${mgr}; using exact name '${query}'" >&2
            echo "$query"
            return 0
            ;;
    esac

    if [[ ${#candidates[@]} -eq 0 ]]; then
        log_err "No ${mgr} package matches '${query}'"
        return 1
    fi

    log_info "Packages matching '${query}' (${mgr}):" >&2
    local choice
    radioselect choice "" -1 "${candidates[@]}" || return 1
    echo "${candidates[$choice]}"
}

# @name _pkg_available
# @description Internal: return 0 if a package by the exact name exists for the
#              given manager (installed or installable). Used by pkg_ensure to
#              decide whether to auto-fall back to a search menu. Only apt/dnf are
#              checked; other managers return 0 (no fallback -- keep exact name).
# @param $1 string  Manager
# @param $2 string  Exact package name
# @returns 0 exists or not checkable, 1 unknown to apt/dnf
_pkg_available() {
    local mgr="$1" pkg="$2"
    case "$mgr" in
        dnf) dnf info "$pkg" &>/dev/null ;;
        apt) apt-cache show "$pkg" &>/dev/null ;;
        *)   return 0 ;;
    esac
}

# @name pkg_installed
# @description Check if a package is installed and report the result. Returns 0 if
#              installed, 1 if not, 2 if the manager is unusable. Supports apt,
#              dnf, pip, pnpm, npm, go, and cargo (rust).
# @param -m | --manager string  Package manager: apt | dnf | pip | pnpm | npm | go | cargo
#                                (default: $PKG_DEFAULT_MANAGER, dnf)
# @param -p | --package string  Package name to check
# @param -g | --global  flag    Optional, for pip/pnpm/npm global scope
# @param -s | --search  flag    Optional, search apt/dnf and pick from a menu
#                                (other managers fall back to the exact name)
# @example pi bash                    # 'pi' alias; default dnf + positional name
# @example pkg_installed -p git
# @example pkg_installed -m dnf vim   # -p optional: package name may be positional
# @example pkg_installed -m npm -p eslint -g
# @example pkg_installed -p chrome -s
pkg_installed() {
    local mgr="${PKG_DEFAULT_MANAGER:-dnf}" pkg="" global_flag=false search_flag=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m | --manager) mgr="$2"; shift 2 ;;
            -p | --package) pkg="$2"; shift 2 ;;
            -g | --global)  global_flag=true; shift ;;
            -s | --search)  search_flag=true; shift ;;
            *) [[ -z "$pkg" && "$1" != -* ]] && pkg="$1"; shift ;;
        esac
    done

    if [[ -z "$pkg" ]]; then
        log_err "Usage: pkg_installed [-m <${PKG_MANAGERS_HELP}>] [-p] <package> [-g] [-s]"
        return 1
    fi

    if [[ "$search_flag" == true ]]; then
        local resolved
        resolved=$(_pkg_search_select "$mgr" "$pkg") || return 1
        pkg="$resolved"
    fi

    _pkg_is_installed "$mgr" "$pkg" "$global_flag"
    local rc=$?
    case "$rc" in
        0) log_ok "${pkg} is installed (${mgr})"; return 0 ;;
        1) log_err "${pkg} is not installed (${mgr})"; return 1 ;;
        *) return "$rc" ;;  # 2: _pkg_is_installed already logged the reason
    esac
}
alias pkg-installed='pkg_installed'
alias pi='pkg_installed'

# @name pkg_ensure
# @description Check if a package is installed, prompt to install if not.
#              Supports apt, dnf, pip, pnpm, npm, go, and cargo (rust). If the
#              exact name is unknown to apt/dnf, automatically falls back to a
#              search menu; -s forces the menu even when the name matches.
# @param -m | --manager string  Package manager: apt | dnf | pip | pnpm | npm | go | cargo
#                                (default: $PKG_DEFAULT_MANAGER, dnf)
# @param -p | --package string  Package name to check and optionally install
# @param -g | --global  flag    Optional, for pip/pnpm/npm global install
# @param -y | --yes     flag    Optional, auto-confirm install (non-interactive)
# @param -s | --search  flag    Optional, search apt/dnf and pick from a menu
#                                (other managers fall back to the exact name)
# @example pe chrome                 # exact name unknown to dnf -> auto search menu
# @example pe shfmt                  # 'pe' alias; default dnf + positional name
# @example pkg_ensure -m dnf -p shfmt
# @example pkg_ensure -m dnf shfmt   # -p optional: package name may be positional
# @example pkg_ensure -p chrome -s
# @example pkg_ensure -m apt -p git -y
# @example pkg_ensure -m pip -p requests
# @example pkg_ensure -m pnpm -p typescript -g
# @example pkg_ensure -m npm -p eslint -g
# @example pkg_ensure -m go -p golang.org/x/tools/cmd/goimports
# @example pkg_ensure -m cargo -p ripgrep
pkg_ensure() {
    local mgr="${PKG_DEFAULT_MANAGER:-dnf}" pkg="" global_flag=false yes_flag=false search_flag=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m | --manager) mgr="$2"; shift 2 ;;
            -p | --package) pkg="$2"; shift 2 ;;
            -g | --global)  global_flag=true; shift ;;
            -s | --search)  search_flag=true; shift ;;
            -y | --yes)     yes_flag=true; shift ;;
            *) [[ -z "$pkg" && "$1" != -* ]] && pkg="$1"; shift ;;
        esac
    done

    if [[ -z "$pkg" ]]; then
        log_err "Usage: pkg_ensure [-m <${PKG_MANAGERS_HELP}>] [-p] <package> [-g] [-y] [-s]"
        return 1
    fi

    if [[ "$search_flag" == true ]]; then
        local resolved
        resolved=$(_pkg_search_select "$mgr" "$pkg") || return 1
        pkg="$resolved"
    fi

    # ── Check installed status ────────────────────────────────────────────────
    _pkg_is_installed "$mgr" "$pkg" "$global_flag"
    local rc=$?
    [[ "$rc" -eq 2 ]] && return 2  # unusable manager; helper already logged
    if [[ "$rc" -eq 0 ]]; then
        log_ok "${pkg} is already installed (${mgr})"
        return 0
    fi

    # ── Auto-fallback: exact name unknown to apt/dnf -> open a search menu ─────
    if [[ "$search_flag" != true ]] && ! _pkg_available "$mgr" "$pkg"; then
        log_warn "'${pkg}' not found in ${mgr}; searching for similar packages..."
        local picked
        picked=$(_pkg_search_select "$mgr" "$pkg") || return 1
        pkg="$picked"
        if _pkg_is_installed "$mgr" "$pkg" "$global_flag"; then
            log_ok "${pkg} is already installed (${mgr})"
            return 0
        fi
    fi

    # ── Prompt to install ─────────────────────────────────────────────────────
    log_err "${pkg} is not installed (${mgr})"
    local answer="n"
    if [[ "$yes_flag" == true ]]; then
        answer="y"
    else
        read -rp "Install ${pkg} now via ${mgr}? (y/N): " answer
    fi

    if [[ "${answer,,}" == "y" ]]; then
        log_step "Installing ${pkg} via ${mgr}..."
        case "$mgr" in
            apt)   sudo apt install -y "$pkg" ;;
            dnf)   sudo dnf install -y "$pkg" ;;
            pip)   pip install "$pkg" ;;
            pnpm)
                if [[ "$global_flag" == true ]]; then
                    pnpm add -g "$pkg"
                else
                    pnpm add "$pkg"
                fi
                ;;
            npm)
                if [[ "$global_flag" == true ]]; then
                    npm install -g "$pkg"
                else
                    npm install "$pkg"
                fi
                ;;
            go)    go install "${pkg}@latest" ;;
            cargo) cargo install "$pkg" ;;
        esac

        if [[ $? -eq 0 ]]; then
            log_ok "${pkg} installed successfully"
        else
            log_err "Failed to install ${pkg}"
            return 1
        fi
    else
        log_step "Skipped installation of ${pkg}"
        return 1
    fi
}
alias pkg-ensure='pkg_ensure'
alias pe='pkg_ensure'

# @name pkg_remove
# @description Check if a package is installed, prompt to remove if so. Counterpart
#              to pkg_ensure. Supports apt, dnf, pip, pnpm, npm, go, and cargo (rust).
# @param -m | --manager string  Package manager: apt | dnf | pip | pnpm | npm | go | cargo
#                                (default: $PKG_DEFAULT_MANAGER, dnf)
# @param -p | --package string  Package name to check and optionally remove
# @param -g | --global  flag    Optional, for pip/pnpm/npm global package
# @param -y | --yes     flag    Optional, auto-confirm removal (non-interactive)
# @param -s | --search  flag    Optional, search apt/dnf and pick from a menu
#                                (other managers fall back to the exact name)
# @example prm shfmt -y              # 'prm' alias; default dnf, auto-confirm removal
# @example pkg_remove -m dnf -p shfmt
# @example pkg_remove -m dnf shfmt   # -p optional: package name may be positional
# @example pkg_remove -p chrome -s
# @example pkg_remove -m apt -p git -y
# @example pkg_remove -m npm -p eslint -g
# @example pkg_remove -m go -p goimports
# @example pkg_remove -m cargo -p ripgrep
pkg_remove() {
    local mgr="${PKG_DEFAULT_MANAGER:-dnf}" pkg="" global_flag=false yes_flag=false search_flag=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m | --manager) mgr="$2"; shift 2 ;;
            -p | --package) pkg="$2"; shift 2 ;;
            -g | --global)  global_flag=true; shift ;;
            -s | --search)  search_flag=true; shift ;;
            -y | --yes)     yes_flag=true; shift ;;
            *) [[ -z "$pkg" && "$1" != -* ]] && pkg="$1"; shift ;;
        esac
    done

    if [[ -z "$pkg" ]]; then
        log_err "Usage: pkg_remove [-m <${PKG_MANAGERS_HELP}>] [-p] <package> [-g] [-y] [-s]"
        return 1
    fi

    if [[ "$search_flag" == true ]]; then
        local resolved
        resolved=$(_pkg_search_select "$mgr" "$pkg") || return 1
        pkg="$resolved"
    fi

    # ── Check installed status ────────────────────────────────────────────────
    _pkg_is_installed "$mgr" "$pkg" "$global_flag"
    local rc=$?
    [[ "$rc" -eq 2 ]] && return 2  # unusable manager; helper already logged
    if [[ "$rc" -ne 0 ]]; then
        log_ok "${pkg} is not installed (${mgr}), nothing to remove"
        return 0
    fi

    # ── Prompt to remove ──────────────────────────────────────────────────────
    log_warn "${pkg} is installed (${mgr})"
    local answer="n"
    if [[ "$yes_flag" == true ]]; then
        answer="y"
    else
        read -rp "Remove ${pkg} now via ${mgr}? (y/N): " answer
    fi

    if [[ "${answer,,}" == "y" ]]; then
        log_step "Removing ${pkg} via ${mgr}..."
        case "$mgr" in
            apt)   sudo apt remove -y "$pkg" ;;
            dnf)   sudo dnf remove -y "$pkg" ;;
            pip)   pip uninstall -y "$pkg" ;;
            pnpm)
                if [[ "$global_flag" == true ]]; then
                    pnpm remove -g "$pkg"
                else
                    pnpm remove "$pkg"
                fi
                ;;
            npm)
                if [[ "$global_flag" == true ]]; then
                    npm uninstall -g "$pkg"
                else
                    npm uninstall "$pkg"
                fi
                ;;
            go)    rm -f "$(go env GOPATH)/bin/$(basename "$pkg")" ;;
            cargo) cargo uninstall "$pkg" ;;
        esac

        if [[ $? -eq 0 ]]; then
            log_ok "${pkg} removed successfully"
        else
            log_err "Failed to remove ${pkg}"
            return 1
        fi
    else
        log_step "Skipped removal of ${pkg}"
        return 1
    fi
}
alias pkg-remove='pkg_remove'
alias prm='pkg_remove'

# @name pkg_unused
# @description Report installed rpm packages that have never been used, ranked by
#              size. Usage comes from atime (rpm installs files with atime ==
#              mtime, so a later atime means something read them); the safety call
#              comes from a `dnf remove --assumeno` pass on each candidate. Both
#              live in pkg_usage.py next to this file -- see its header for the
#              blind spots, which is required reading before deleting anything.
#              Only DELETABLE rows are offered for removal; REVIEW rows are listed
#              with the reason but never selectable, because idle packages can
#              still be load-bearing (@core members, rescue tools, a service whose
#              binaries systemd hides from atime).
# @param -s | --min-size number  Size floor in MB: hides smaller rows and bounds
#                                 the dnf pass, which costs ~0.5s per candidate
#                                 (default: 5)
# @param -a | --all      flag    List every package, not just candidates
# @param -q | --quick    flag    Skip the dnf pass -- ~1s, but no safety verdict
# @example pun                   # 'pun' alias; candidates over 5 MB
# @example pkg_unused -s 50      # only the big ones
# @example pkg_unused -a -q      # full inventory, no dnf pass
pkg_unused() {
    local min_size=5 show_all=false quick=false
    local engine="${BASH_SOURCE[0]%/*}/pkg_usage.py"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            # A bare -s would leave `shift 2` with nothing to shift, and bash
            # then leaves $# alone -- the while loop spins forever.
            -s | --min-size)
                [[ -n "${2:-}" ]] || { log_err "Missing value for $1"; return 1; }
                min_size="$2"; shift 2 ;;
            -a | --all)      show_all=true; shift ;;
            -q | --quick)    quick=true; shift ;;
            *) log_err "Usage: pkg_unused [-s <MB>] [-a] [-q]"; return 1 ;;
        esac
    done

    command -v python3 &>/dev/null || { log_err "python3 not found"; return 1; }
    command -v dnf &>/dev/null || { log_err "pkg_unused is dnf/rpm only"; return 1; }
    [[ -f "$engine" ]] || { log_err "Engine not found: ${engine}"; return 1; }

    local -a flags=(--min-size "$min_size")
    [[ "$quick" == true ]] && flags+=(--no-dry-run)

    # The dnf pass waits on any other dnf holding the lock -- measured at 166s
    # against a running makecache -- so say why it is slow before it is slow.
    if [[ "$quick" != true ]] && pgrep -x dnf &>/dev/null; then
        log_warn "Another dnf is running; the safety pass will wait on its lock"
    fi

    if [[ "$quick" == true ]]; then
        log_step "Scanning installed packages (no dnf pass -- IDLE rows are ungraded)..."
    else
        log_step "Scanning installed packages (dnf pass on candidates over ${min_size} MB)..."
    fi
    local tsv
    tsv=$(python3 "$engine" "${flags[@]}") || { log_err "Scan failed"; return 1; }

    # The engine already emits largest-first, so no re-sorting here. IDLE only
    # shows up under -q, where the dnf pass that would grade it never ran.
    echo ""
    awk -F'\t' -v all="$show_all" -v quick="$quick" -v minmb="$min_size" \
        'NR > 1 && $2 + 0 >= minmb &&
         (all == "true" || $1 == "DELETABLE" || $1 == "REVIEW" ||
          (quick == "true" && $1 == "IDLE")) {
            # "-" rather than "": column -t merges repeated separators, so an
            # empty cell would slide the note into the deps column.
            printf "%s\t%s MB\t%s\t%s\t%s\n", $1, $2, $5, ($4 > 0 ? "+" $4 " deps" : "-"), $6
        }' <<< "$tsv" | column -t -s$'\t'

    # ── Offer removal of the safe ones ────────────────────────────────────────
    local -a names=() labels=()
    while IFS=$'\t' read -r status mb _ _ name note; do
        [[ "$status" == "DELETABLE" ]] || continue
        names+=("$name")
        labels+=("$(printf '%8.1f MB  %-24s %s' "$mb" "$name" "$note")")
    done < <(tail -n +2 <<< "$tsv")

    if [[ ${#names[@]} -eq 0 ]]; then
        echo ""
        log_ok "Nothing safe enough to suggest removing"
        return 0
    fi

    echo ""
    log_warn "Read pkg_usage.py's blind spots before removing -- a package updated"
    log_warn "recently looks unused even if you use it daily."
    local answer
    read -rp "Pick packages to remove? (y/N): " answer
    [[ "${answer,,}" == "y" ]] || { log_step "Left everything installed"; return 0; }

    local PICKS
    multiselect PICKS "Remove which packages?" "${labels[@]}" || {
        log_step "Cancelled"; return 0
    }
    [[ -n "$PICKS" ]] || { log_step "Nothing selected"; return 0; }

    local i
    for i in $PICKS; do
        pkg_remove -m dnf -p "${names[$i]}" -y
    done
}
alias pkg-unused='pkg_unused'
alias pun='pkg_unused'

# =========================
# --- Toolkit ---
# =========================

# The curated package lists SYS_TOOLKIT / SYS_TOOLKIT_OPTIONAL are defined in
# .bash_env (@section Defaults, sourced before this file), next to
# PKG_DEFAULT_MANAGER -- edit the toolkit there.

# @name _sys_toolkit_menu
# @description Internal: `sys_toolkit -m` UI. Builds a status label per package
#              (installed → remove / missing → install) and delegates the interactive
#              multi-select to the shared multiselect engine, then applies the picks:
#              installed picks are removed (pkg_remove -y), missing picks installed
#              (pkg_ensure -y). Prints an applied/failed summary.
# @param $1     string  Package manager (apt|dnf)
# @param $2..   string  Package names to manage
# @depends multiselect, pkg_ensure, pkg_remove, _pkg_is_installed
_sys_toolkit_menu() {
    local mgr="$1"; shift
    local -a pkgs=("$@")
    local -a installed=() labels=()
    local i tag

    # Build one status label per package; multiselect returns the chosen indices.
    for i in "${!pkgs[@]}"; do
        if _pkg_is_installed "$mgr" "${pkgs[$i]}"; then
            installed[i]=true;  tag="(installed → remove)"
        else
            installed[i]=false; tag="(missing → install)"
        fi
        printf -v "labels[$i]" "%-11s %s" "${pkgs[$i]}" "$tag"
    done

    local selected
    multiselect selected \
        "Toolkit menu (${mgr})" \
        "${labels[@]}" || { log_info "Cancelled"; return 0; }

    local -a picks
    read -ra picks <<< "$selected"
    if [[ ${#picks[@]} -eq 0 ]]; then
        log_info "No packages selected"
        return 0
    fi

    # Apply: installed picks are removed, missing picks are installed.
    local -a failed=()
    local idx pkg
    for idx in "${picks[@]}"; do
        pkg="${pkgs[$idx]}"
        if [[ "${installed[$idx]}" == true ]]; then
            pkg_remove -m "$mgr" -p "$pkg" -y || failed+=("$pkg")
        else
            pkg_ensure -m "$mgr" -p "$pkg" -y || failed+=("$pkg")
        fi
    done

    if [[ ${#failed[@]} -eq 0 ]]; then
        log_ok "Toolkit menu: applied ${#picks[@]} change(s) successfully (${mgr})"
        return 0
    fi
    log_err "Toolkit menu: ${#failed[@]} action(s) failed -> ${failed[*]}"
    return 1
}

# @name sys_toolkit
# @description Manage the curated CLI toolkit. Auto-detects the system package
#              manager (apt/dnf, like sys_update). Two modes:
#              - Batch (default): runs pkg_ensure -y for each entry, so installed
#                tools are skipped and a failed package is recorded without aborting
#                the batch; prints an ok/failed summary and returns non-zero on any
#                failure.
#              - Menu (-m): interactive multi-select over the full set (core +
#                optional) -- pick missing tools to install and installed tools to
#                remove. Delegates the UI to _sys_toolkit_menu.
# @param -o | --optional  flag  Batch mode: also install SYS_TOOLKIT_OPTIONAL (e.g. gh)
# @param -m | --menu      flag  Interactive multi-select install/remove mode
# @depends _pkg_manager, pkg_ensure, pkg_remove, _sys_toolkit_menu
# @example sys_toolkit           # batch: install/verify the default toolkit
# @example sys_toolkit -o        # batch: also include the optional tools (gh, ...)
# @example sys_toolkit -m        # menu: pick tools to install/remove interactively
# @example toolkit               # 'toolkit' alias
sys_toolkit() {
    local include_optional=false menu=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o | --optional) include_optional=true; shift ;;
            -m | --menu)     menu=true; shift ;;
            *) log_err "Unknown option: $1 (usage: sys_toolkit [-o] [-m])"; return 1 ;;
        esac
    done

    # Auto-detect the system package manager (shared with sys_update; _pkg_manager
    # lives in .bash_functions).
    local mgr
    mgr=$(_pkg_manager) || { log_err "No supported package manager found (apt/dnf)"; return 1; }

    # Menu mode manages the full set (core + optional); batch mode honors -o.
    local -a tools=("${SYS_TOOLKIT[@]}")
    if [[ "$menu" == true || "$include_optional" == true ]]; then
        tools+=("${SYS_TOOLKIT_OPTIONAL[@]}")
    fi

    if [[ "$menu" == true ]]; then
        _sys_toolkit_menu "$mgr" "${tools[@]}"
        return $?
    fi

    log_step "Ensuring ${#tools[@]} toolkit package(s) via ${mgr}..."
    local -a failed=()
    local pkg
    for pkg in "${tools[@]}"; do
        pkg_ensure -m "$mgr" -p "$pkg" -y || failed+=("$pkg")
    done

    if [[ ${#failed[@]} -eq 0 ]]; then
        log_ok "Toolkit ready: all ${#tools[@]} package(s) present (${mgr})"
        return 0
    fi
    log_err "Toolkit incomplete: ${#failed[@]} failed -> ${failed[*]}"
    return 1
}
alias sys-toolkit='sys_toolkit'
alias toolkit='sys_toolkit'

# @name ensure_shfmt
# @description Install shfmt from its official GitHub release binary into
#              /usr/local/sbin, since shfmt is not packaged for dnf/EPEL. Resolves
#              the latest version, downloads the matching linux binary plus the
#              release checksum file, verifies the SHA-256, then installs it mode
#              755. Idempotent: skips if shfmt is already on PATH unless -f is given.
# @param -f | --force  flag  Reinstall even if shfmt is already present (upgrade)
# @example ensure_shfmt        # install shfmt if missing
# @example ensure_shfmt -f     # force reinstall / upgrade to latest
ensure_shfmt() {
    local force=false
    [[ "${1:-}" == "-f" || "${1:-}" == "--force" ]] && force=true

    if [[ "$force" != true ]] && command -v shfmt &>/dev/null; then
        log_ok "shfmt already installed: $(shfmt --version 2>/dev/null) ($(command -v shfmt))"
        return 0
    fi
    command -v curl &>/dev/null || { log_err "curl is required to install shfmt"; return 1; }

    # Map uname arch to shfmt's release naming.
    local arch
    case "$(uname -m)" in
        x86_64)  arch=amd64 ;;
        aarch64) arch=arm64 ;;
        *) log_err "Unsupported architecture: $(uname -m)"; return 1 ;;
    esac

    # Resolve the latest release tag (e.g. v3.10.0) from the GitHub API.
    local tag
    tag=$(curl -fsSL https://api.github.com/repos/mvdan/sh/releases/latest \
        | grep -oP '"tag_name":\s*"\K[^"]+')
    if [[ -z "$tag" ]]; then
        log_err "Failed to resolve latest shfmt version"
        return 1
    fi

    local asset="shfmt_${tag}_linux_${arch}"
    local base="https://github.com/mvdan/sh/releases/download/${tag}"
    local tmp; tmp=$(mktemp -d) || { log_err "mktemp failed"; return 1; }

    log_step "Downloading ${asset} (${tag}) and verifying checksum..."
    if curl -fsSL "${base}/${asset}" -o "${tmp}/${asset}" \
        && curl -fsSL "${base}/sha256sums.txt" -o "${tmp}/sums.txt" \
        && (cd "$tmp" && grep " ${asset}\$" sums.txt | sha256sum -c --status -) \
        && sudo install -m 755 "${tmp}/${asset}" /usr/local/sbin/shfmt; then
        log_ok "shfmt installed: $(shfmt --version 2>/dev/null) (/usr/local/sbin/shfmt)"
        rm -rf "$tmp"
    else
        log_err "Failed to install shfmt ${tag} (download/checksum/install error)"
        rm -rf "$tmp"
        return 1
    fi
}
alias ensure-shfmt='ensure_shfmt'
############################################################
