{
    "permissions": {
        "allow": [
            "Bash(git check-ignore*)",
            "Bash(git ls-files*)",
            "Bash(rclone ls *)",
            "Bash(rclone lsd *)",
            "Bash(rclone lsf *)",
            "Bash(rclone about *)",
            "Bash(rclone mkdir gdrive:claude/*)",
            "Bash(rclone copy gdrive:claude/*)",
            "Bash(rclone copyto gdrive:claude/*)"
        ],
        "ask": [
            "Bash(rclone sync*)",
            "Bash(rclone bisync*)",
            "Bash(rclone move*)",
            "Bash(rclone delete*)",
            "Bash(rclone purge*)",
            "Bash(rclone rmdir*)",
            "Bash(rclone dedupe*)",
            "Bash(rclone cleanup*)"
        ],
        "deny": [
            "Read(~/.config/rclone/**)",
            "Edit(~/.config/rclone/**)",
            "Bash(rclone config show*)",
            "Bash(rclone config dump*)",
            "Read(~/.config/secrets/**)",
            "Edit(~/.config/secrets/**)",
            "Bash(cat ~/.config/secrets*)"
        ]
    },
    "model": "opus",
    "language": "traditional chinese (Taiwan)",
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "echo '請一律用繁體中文（台灣用語）回答 Roger，即使工具輸出、程式碼或註解是英文；程式碼、指令與 commit 訊息照原本的語言。'"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-bash-bypass.sh\""
                    }
                ]
            }
        ]
    },
    "modelSettings": {
        "claude-opus-5-5": {
            "effortLevel": "high"
        },
        "claude-sonnet-5-5": {
            "effortLevel": "medium"
        }
    }
}
