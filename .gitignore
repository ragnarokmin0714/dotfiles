# =============================================================================
# .gitignore — Dotfiles Repository
# =============================================================================

# Host-local settings: secrets and per-machine values (templates are *.example*)
config.local.sh
configs/alias/.bash_local

# Backup files
*.bak

# Editor and OS artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Secrets — never commit these
*.env
*.secret
*.key
*.pem
*.crt
secrets/
