# =============================================================================
# .gitignore — Dotfiles Repository
# =============================================================================

# Runtime log files (generated by lib/log.sh at runtime)
logs/*.log

# Keep the logs directory itself in version control
!logs/.gitkeep

# Editor and OS artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Secrets — never commit these
*.env
*.secret
*.key
*.pem
*.crt
secrets/
